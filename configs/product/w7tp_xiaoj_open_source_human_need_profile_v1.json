{
  "schema_version": "w7tp.xiaoj-open-source-human-need-profile.v1",
  "product_mode": "OPEN_SOURCE_LOCAL_FIRST",
  "product_name": "XiaoJ Sovereign Member System",
  "core_deployment": {
    "single_node_core_supported": true,
    "minimum_stack": [
      "taiji01",
      "Odoo",
      "PostgreSQL",
      "Python",
      "Browser_or_PWA"
    ],
    "paid_cloud_required": false,
    "enterprise_sso_required": false,
    "kubernetes_required": false,
    "google_required": false,
    "line_required": false,
    "cloud_llm_required": false,
    "tailscale_required": false,
    "offline_or_local_degraded_mode_required": true,
    "provider_replaceable": true,
    "forkable_role_need_registry": true
  },
  "competitive_value": [
    "natural_person_sovereignty",
    "multi_role_same_person",
    "human_need_first_routing",
    "local_first_privacy",
    "provider_optional",
    "auditable_candidate_before_effect",
    "low_cost_single_node_deployment",
    "community_and_small_organization_fit"
  ],
  "routing_rules": {
    "natural_person_is_not_role": true,
    "role_is_not_seat": true,
    "role_is_not_need": true,
    "same_person_may_have_multiple_roles": true,
    "no_role_inference_from_sensitive_data": true,
    "ambiguous_role_or_need_requires_human_choice": true,
    "raw_intent_must_not_be_persisted_by_router": true,
    "candidate_only": true,
    "execution_allowed": false
  },
  "role_aliases": {
    "member": "member",
    "resident": "resident",
    "tenant": "resident",
    "unit_owner": "unit_owner",
    "consumer": "consumer",
    "volunteer": "volunteer",
    "staff": "staff",
    "merchant_staff": "merchant_staff",
    "committee_chair": "committee_member",
    "committee_member": "committee_member",
    "property_manager": "property_staff",
    "guard": "property_staff",
    "responsible_person": "organization_responsible",
    "representative": "organization_responsible",
    "position_responsible": "organization_responsible",
    "owner_reviewer": "organization_responsible",
    "social_worker": "social_worker",
    "caregiver": "caregiver",
    "family_head": "family_head",
    "family_member": "family_member",
    "operator": "operator"
  },
