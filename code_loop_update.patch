+## 程式碼閉環缺口物件
+
+```json
+{
+  "gap_id": "穩定識別",
+  "broken_link": "定義—實作／實作—呼叫／輸入—輸出／正常—錯誤／程式—測試／測試—接線／接線—效果／修改—證據／生成來源／回復／跨節點",
+  "before_coordinate": {},
+  "after_coordinate": {},
+  "evidence_refs": [],
+  "impact_radius": "局部／群組／系統／治理／未知",
+  "confidence": "已證明／強推論／弱推論／缺證據",
+  "blocking": "阻斷／重大／一般／待確認",
+  "unknown_frontier": [],
