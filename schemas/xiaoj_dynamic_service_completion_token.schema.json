{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XiaoJDynamicServiceCompletionToken",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "token_id": {"type": "string"},
    "task_hash": {"type": "string"},
    "requester_anchor": {"type": "string"},
    "volunteer_anchor": {"type": "string"},
    "time_nonce": {"type": "string"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "completion_scope": {"type": "string", "enum": ["delivery_arrived", "item_received", "staff_manual_close"]},
    "pii_embedded": {"const": false},
    "replay_protection_required": {"const": true},
    "signature": {"type": "string"}
  },
  "required": ["token_id", "task_hash", "requester_anchor", "volunteer_anchor", "time_nonce", "issued_at", "expires_at", "completion_scope", "pii_embedded", "replay_protection_required", "signature"]
}
