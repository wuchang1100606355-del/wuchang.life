{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taiji-hub.local/schemas/intent_field/cloud_candidate_response.schema.json",
  "title": "Intent Field Cloud Candidate Response",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_id",
    "request_id",
    "candidate_only",
    "cloud_call_executed",
    "candidate_artifacts",
    "forbidden_data_scan",
    "total_field_final_authority"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "request_id": { "type": "string" },
    "candidate_only": { "const": true },
    "cloud_call_executed": { "type": "boolean" },
    "candidate_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_type", "candidate_ref"],
        "properties": {
          "artifact_type": { "type": "string" },
          "candidate_ref": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    },
    "forbidden_data_scan": {
      "type": "object",
      "required": ["status", "hard_risk_count"],
      "properties": {
        "status": { "enum": ["PASS", "HOLD"] },
        "hard_risk_count": { "type": "integer", "minimum": 0 }
      }
    },
    "total_field_final_authority": { "const": true }
  }
}
