{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taiji-hub.local/schemas/intent_field/integrated_p0_verify.schema.json",
  "title": "Integrated P0 Verify Sandbox",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_type",
    "sandbox_only",
    "source_refs",
    "component_packets",
    "governance_decision",
    "technical_means",
    "safety_boundary"
  ],
  "properties": {
    "packet_type": { "const": "integrated_p0_verify_sandbox" },
    "sandbox_only": { "const": true },
    "source_refs": { "type": "object" },
    "component_packets": {
      "type": "object",
      "required": [
        "sovereign_identity_agent",
        "state_field_packet_runtime",
        "front_edge_proxy_blocking",
        "accountable_record_chain"
      ]
    },
    "governance_decision": {
      "type": "object",
      "required": [
        "total_field_only_decision_authority",
        "cloud_candidate_decision",
        "decision",
        "restricted_execution_instruction_ref",
        "result_packet_ref",
        "accountable_record_ref"
      ],
      "properties": {
        "total_field_only_decision_authority": { "const": true },
        "cloud_candidate_decision": { "const": false },
        "decision": { "enum": ["ALLOW_RESTRICTED", "HOLD", "REJECT", "BLOCK"] },
        "restricted_execution_instruction_ref": { "type": "string" },
        "result_packet_ref": { "type": "string" },
        "accountable_record_ref": { "type": "string" }
      }
    },
    "technical_means": { "type": "object" },
    "safety_boundary": {
      "type": "object",
      "required": [
        "production_system_connected",
        "production_member_db_connected",
        "db_write",
        "deploy",
        "restart",
        "auto_landing",
        "no_secret",
        "no_member_plaintext",
        "h64_td_ref_only"
      ],
      "properties": {
        "production_system_connected": { "const": false },
        "production_member_db_connected": { "const": false },
        "db_write": { "const": false },
        "deploy": { "const": false },
        "restart": { "const": false },
        "auto_landing": { "const": false },
        "no_secret": { "const": true },
        "no_member_plaintext": { "const": true },
        "h64_td_ref_only": { "const": true }
      }
    }
  }
}
