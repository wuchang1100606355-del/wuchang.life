{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/intent_field/product_intent_state_packet.schema.json",
  "title": "Product Intent State Packet",
  "type": "object",
  "required": [
    "run_id",
    "intent_request_id",
    "candidate_action_id",
    "state_packet_id",
    "multi_state_field_codes",
    "state_field_relation_table",
    "spacetime_index_ref",
    "identity_proxy_ref",
    "authority_scope_code",
    "consent_state_code",
    "reference_code",
    "coordinate_code",
    "hash_value",
    "mask_code",
    "permission_code",
    "state_code",
    "verifier_result",
    "risk_code",
    "hold_reason_code",
    "rule_version",
    "timestamp_coordinate",
    "previous_record_hash",
    "current_record_hash",
    "db_write",
    "deploy",
    "restart"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "intent_request_id": { "type": "string", "pattern": "^intent_request_id:" },
    "candidate_action_id": { "type": "string", "pattern": "^candidate_action_id:" },
    "state_packet_id": { "type": "string", "pattern": "^state_packet_id:" },
    "multi_state_field_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "state_field_relation_table": {
      "type": "array",
      "items": { "type": "object" }
    },
    "spacetime_index_ref": { "type": "string", "pattern": "^spacetime_index_ref:" },
    "identity_proxy_ref": { "type": "string", "pattern": "^identity_proxy_ref:" },
    "authority_scope_code": { "type": "string", "pattern": "^authority_scope_code:" },
    "consent_state_code": { "type": "string", "pattern": "^consent_state_code:" },
    "reference_code": { "type": "string" },
    "coordinate_code": { "type": "string" },
    "hash_value": { "type": "string", "pattern": "^hash:" },
    "mask_code": { "type": "string" },
    "permission_code": { "type": "string" },
    "state_code": { "type": "string" },
    "verifier_result": { "enum": ["PASS", "HOLD"] },
    "risk_code": { "type": "string" },
    "hold_reason_code": { "type": "string" },
    "rule_version": { "type": "string" },
    "timestamp_coordinate": { "type": "string" },
    "previous_record_hash": { "type": "string", "pattern": "^hash:" },
    "current_record_hash": { "type": "string", "pattern": "^hash:" },
    "db_write": { "const": false },
    "deploy": { "const": false },
    "restart": { "const": false }
  },
  "additionalProperties": true
}
