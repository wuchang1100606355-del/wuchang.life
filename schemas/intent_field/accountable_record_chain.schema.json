{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taiji-hub.local/schemas/intent_field/accountable_record_chain.schema.json",
  "title": "Accountable Record Chain Sandbox",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_type",
    "sandbox_only",
    "source_refs",
    "records",
    "technical_means",
    "safety_boundary"
  ],
  "properties": {
    "packet_type": { "const": "accountable_record_chain_sandbox" },
    "sandbox_only": { "const": true },
    "source_refs": {
      "type": "object",
      "required": ["seal_ref", "state_field_packet_runtime_ref", "candidate_ref"],
      "properties": {
        "seal_ref": { "$ref": "#/$defs/file_ref" },
        "state_field_packet_runtime_ref": { "$ref": "#/$defs/file_ref" },
        "candidate_ref": { "$ref": "#/$defs/file_ref" }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accountable_record" }
    },
    "technical_means": {
      "type": "object",
      "required": [
        "modules",
        "data_structures",
        "record_fields",
        "verification_conditions",
        "blocking_conditions"
      ],
      "properties": {
        "modules": { "type": "array", "minItems": 1 },
        "data_structures": { "type": "array", "minItems": 1 },
        "record_fields": { "type": "array", "minItems": 1 },
        "verification_conditions": { "type": "array", "minItems": 1 },
        "blocking_conditions": { "type": "array", "minItems": 1 }
      }
    },
    "safety_boundary": {
      "type": "object",
      "required": [
        "production_ledger_write",
        "db_write",
        "deploy",
        "restart",
        "auto_landing",
        "no_secret",
        "no_member_plaintext",
        "h64_td_ref_only"
      ],
      "properties": {
        "production_ledger_write": { "const": false },
        "db_write": { "const": false },
        "deploy": { "const": false },
        "restart": { "const": false },
        "auto_landing": { "const": false },
        "no_secret": { "const": true },
        "no_member_plaintext": { "const": true },
        "h64_td_ref_only": { "const": true }
      }
    }
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "required": ["path_ref", "sha256"],
      "properties": {
        "path_ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "accountable_record": {
      "type": "object",
      "required": [
        "candidate_action_id",
        "state_packet_id",
        "rule_version",
        "verifier_result",
        "execution_result",
        "timestamp_coordinate",
        "responsible_person_ref",
        "previous_record_hash",
        "current_record_hash",
        "plaintext_archive_ref",
        "access_request_id",
        "requester_identity_ref",
        "authority_basis",
        "access_reason_code",
        "approval_result"
      ],
      "properties": {
        "candidate_action_id": { "type": "string", "minLength": 1 },
        "state_packet_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 },
        "verifier_result": { "type": "string", "minLength": 1 },
        "execution_result": { "type": "string", "minLength": 1 },
        "timestamp_coordinate": { "type": "string", "minLength": 1 },
        "responsible_person_ref": { "type": "string", "minLength": 1 },
        "previous_record_hash": { "type": "string", "pattern": "^hash:[a-f0-9]{64}$" },
        "current_record_hash": { "type": "string", "pattern": "^hash:[a-f0-9]{64}$" },
        "plaintext_archive_ref": { "type": "string", "minLength": 1 },
        "access_request_id": { "type": "string", "minLength": 1 },
        "requester_identity_ref": { "type": "string", "minLength": 1 },
        "authority_basis": { "type": "string", "minLength": 1 },
        "access_reason_code": { "type": "string", "minLength": 1 },
        "approval_result": { "type": "string", "minLength": 1 }
      }
    }
  }
}
