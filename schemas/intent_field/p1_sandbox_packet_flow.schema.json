{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taiji-hub.local/schemas/intent_field/p1_sandbox_packet_flow.schema.json",
  "title": "P1 Sandbox Packet Flow",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_type",
    "sandbox_only",
    "source_refs",
    "p0_stage_decision",
    "flow_steps",
    "component_packets",
    "integrated_packet",
    "p1_decision",
    "technical_means",
    "safety_boundary"
  ],
  "properties": {
    "packet_type": { "const": "p1_sandbox_packet_flow" },
    "sandbox_only": { "const": true },
    "source_refs": { "type": "object" },
    "p0_stage_decision": {
      "type": "object",
      "required": [
        "P1_ALLOWED",
        "ALLOW_PRODUCTION",
        "ALLOW_DB_WRITE",
        "ALLOW_DEPLOY",
        "ALLOW_RESTART"
      ],
      "properties": {
        "P1_ALLOWED": { "const": true },
        "ALLOW_PRODUCTION": { "const": false },
        "ALLOW_DB_WRITE": { "const": false },
        "ALLOW_DEPLOY": { "const": false },
        "ALLOW_RESTART": { "const": false }
      }
    },
    "flow_steps": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["order", "step", "status"]
      }
    },
    "component_packets": {
      "type": "object",
      "required": [
        "sovereign_identity_agent",
        "state_field_packet_runtime",
        "front_edge_proxy_blocking",
        "accountable_record_chain"
      ]
    },
    "integrated_packet": { "type": "object" },
    "p1_decision": {
      "type": "object",
      "required": [
        "total_field_only_decision_authority",
        "cloud_candidate_decision",
        "decision",
        "restricted_execution_instruction_ref",
        "result_packet_ref",
        "accountable_record_ref"
      ],
      "properties": {
        "total_field_only_decision_authority": { "const": true },
        "cloud_candidate_decision": { "const": false },
        "decision": { "enum": ["ALLOW_RESTRICTED", "HOLD", "REJECT", "BLOCK"] },
        "restricted_execution_instruction_ref": { "type": "string" },
        "result_packet_ref": { "type": "string" },
        "accountable_record_ref": { "type": "string" }
      }
    },
    "technical_means": { "type": "object" },
    "safety_boundary": {
      "type": "object",
      "required": [
        "production_system_connected",
        "production_member_db_connected",
        "db_write",
        "deploy",
        "restart",
        "router_write",
        "auto_landing",
        "cloud_call_executed",
        "no_secret",
        "no_member_plaintext",
        "h64_td_ref_only"
      ],
      "properties": {
        "production_system_connected": { "const": false },
        "production_member_db_connected": { "const": false },
        "db_write": { "const": false },
        "deploy": { "const": false },
        "restart": { "const": false },
        "router_write": { "const": false },
        "auto_landing": { "const": false },
        "cloud_call_executed": { "const": false },
        "no_secret": { "const": true },
        "no_member_plaintext": { "const": true },
        "h64_td_ref_only": { "const": true }
      }
    }
  }
}
