{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taiji-hub.local/schemas/intent_field/p2_sandbox_runtime_harness.schema.json",
  "title": "P2 Sandbox Runtime Harness",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_type",
    "sandbox_only",
    "source_refs",
    "p1_stage_decision",
    "runtime_fixture",
    "verifier_chain",
    "result_packet",
    "p1_packet_flow",
    "p1_verifier",
    "technical_means",
    "safety_boundary"
  ],
  "properties": {
    "packet_type": { "const": "p2_sandbox_runtime_harness" },
    "sandbox_only": { "const": true },
    "source_refs": { "type": "object" },
    "p1_stage_decision": {
      "type": "object",
      "required": [
        "P2_ALLOWED",
        "ALLOW_PRODUCTION",
        "ALLOW_DB_WRITE",
        "ALLOW_DEPLOY",
        "ALLOW_RESTART",
        "ALLOW_ROUTER_WRITE"
      ],
      "properties": {
        "P2_ALLOWED": { "const": true },
        "ALLOW_PRODUCTION": { "const": false },
        "ALLOW_DB_WRITE": { "const": false },
        "ALLOW_DEPLOY": { "const": false },
        "ALLOW_RESTART": { "const": false },
        "ALLOW_ROUTER_WRITE": { "const": false }
      }
    },
    "runtime_fixture": {
      "type": "object",
      "required": [
        "fixture_id",
        "sandbox_only",
        "returned_cloud_candidate_ref",
        "verified_candidate_ref",
        "candidate_hash_match",
        "input_mode",
        "production_connector"
      ],
      "properties": {
        "sandbox_only": { "const": true },
        "candidate_hash_match": { "const": true },
        "input_mode": { "const": "ref_only_fixture" },
        "production_connector": { "const": false }
      }
    },
    "verifier_chain": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["order", "step", "status"]
      }
    },
    "result_packet": {
      "type": "object",
      "required": [
        "sandbox_only",
        "decision",
        "total_field_only_decision_authority",
        "cloud_candidate_decision",
        "executable_api_call_generated",
        "business_write_forwarded",
        "db_write",
        "deploy",
        "restart"
      ],
      "properties": {
        "sandbox_only": { "const": true },
        "decision": { "enum": ["ALLOW_RESTRICTED", "HOLD", "REJECT", "BLOCK"] },
        "total_field_only_decision_authority": { "const": true },
        "cloud_candidate_decision": { "const": false },
        "executable_api_call_generated": { "const": false },
        "business_write_forwarded": { "const": false },
        "db_write": { "const": false },
        "deploy": { "const": false },
        "restart": { "const": false }
      }
    },
    "p1_packet_flow": { "type": "object" },
    "p1_verifier": { "type": "object" },
    "technical_means": { "type": "object" },
    "safety_boundary": {
      "type": "object",
      "required": [
        "sandbox_only",
        "production_connector",
        "production_system_connected",
        "production_member_db_connected",
        "db_write",
        "deploy",
        "restart",
        "router_write",
        "auto_landing",
        "cloud_call_executed",
        "no_secret",
        "no_member_plaintext",
        "h64_td_ref_only"
      ],
      "properties": {
        "sandbox_only": { "const": true },
        "production_connector": { "const": false },
        "production_system_connected": { "const": false },
        "production_member_db_connected": { "const": false },
        "db_write": { "const": false },
        "deploy": { "const": false },
        "restart": { "const": false },
        "router_write": { "const": false },
        "auto_landing": { "const": false },
        "cloud_call_executed": { "const": false },
        "no_secret": { "const": true },
        "no_member_plaintext": { "const": true },
        "h64_td_ref_only": { "const": true }
      }
    }
  }
}
