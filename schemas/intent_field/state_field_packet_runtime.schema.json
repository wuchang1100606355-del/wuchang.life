{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taiji-hub.local/schemas/intent_field/state_field_packet_runtime.schema.json",
  "title": "State Field Packet Runtime Sandbox",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_type",
    "sandbox_only",
    "source_candidate_ref",
    "state_field_packet",
    "technical_means",
    "safety_boundary"
  ],
  "properties": {
    "packet_type": { "const": "state_field_packet_runtime_sandbox" },
    "sandbox_only": { "const": true },
    "source_candidate_ref": {
      "type": "object",
      "required": ["path_ref", "sha256"],
      "properties": {
        "path_ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "state_field_packet": {
      "type": "object",
      "required": [
        "state_field_set_id",
        "state_field_version",
        "state_field_relation_table",
        "transition_trigger_code",
        "transition_reason_code",
        "before_state_field_hash",
        "after_state_field_hash",
        "dynamic_field_policy_id",
        "timestamp_coordinate",
        "verifier_result"
      ],
      "properties": {
        "state_field_set_id": { "type": "string", "minLength": 1 },
        "state_field_version": { "type": "string", "minLength": 1 },
        "state_field_relation_table": { "type": "array", "minItems": 1 },
        "transition_trigger_code": { "type": "string", "minLength": 1 },
        "transition_reason_code": { "type": "string", "minLength": 1 },
        "before_state_field_hash": { "type": "string", "pattern": "^hash:[a-f0-9]{64}$" },
        "after_state_field_hash": { "type": "string", "pattern": "^hash:[a-f0-9]{64}$" },
        "dynamic_field_policy_id": { "type": "string", "minLength": 1 },
        "timestamp_coordinate": { "type": "string", "minLength": 1 },
        "verifier_result": { "enum": ["PASS", "REVIEW", "HOLD", "FAIL"] }
      }
    },
    "technical_means": {
      "type": "object",
      "required": [
        "modules",
        "data_structures",
        "packet_fields",
        "verification_conditions",
        "blocking_conditions",
        "record_fields"
      ],
      "properties": {
        "modules": { "type": "array", "minItems": 1 },
        "data_structures": { "type": "array", "minItems": 1 },
        "packet_fields": { "type": "array", "minItems": 1 },
        "verification_conditions": { "type": "array", "minItems": 1 },
        "blocking_conditions": { "type": "array", "minItems": 1 },
        "record_fields": { "type": "array", "minItems": 1 }
      }
    },
    "safety_boundary": {
      "type": "object",
      "required": [
        "db_write",
        "deploy",
        "restart",
        "auto_landing",
        "no_secret",
        "no_member_plaintext",
        "h64_td_ref_only"
      ],
      "properties": {
        "db_write": { "const": false },
        "deploy": { "const": false },
        "restart": { "const": false },
        "auto_landing": { "const": false },
        "no_secret": { "const": true },
        "no_member_plaintext": { "const": true },
        "h64_td_ref_only": { "const": true }
      }
    }
  }
}
