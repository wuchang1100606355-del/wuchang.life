{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuchang.life/schemas/w7tp_scenario_translation_packet.schema.json",
  "title": "W7TP Scenario Translation 8D Packet",
  "type": "object",
  "required": ["packet_id", "schema_version", "selected_container", "packet_type", "capability_ref", "destination_field", "d1_intent", "d2_state", "d3_coordinate", "d4_evidence", "d5_execution", "d6_generative_transmission", "d7_risk", "d8_envelope"],
  "properties": {
    "packet_id": {"type": "string", "minLength": 8},
    "schema_version": {"const": "W7TP-SCENARIO-TRANSLATION/1.0"},
    "selected_container": {"enum": ["ASSOCIATION", "PROPERTY", "CAFE_POS", "HOUSEHOLD", "GENERIC"]},
    "packet_type": {"enum": ["ASSOCIATION_SERVICE_PACKET", "PROPERTY_SERVICE_PACKET", "CAFE_POS_SERVICE_PACKET", "HOUSEHOLD_SERVICE_PACKET", "GENERIC_INTENT_PACKET"]},
    "capability_ref": {"enum": ["CAP_ASSOCIATION_SERVICE_V1", "CAP_PROPERTY_SERVICE_V1", "CAP_CAFE_POS_SERVICE_V1", "CAP_HOUSEHOLD_SERVICE_V1", "CAP_GENERIC_INTENT_V1"]},
    "destination_field": {"type": "string", "minLength": 3},
    "d1_intent": {"type": "object", "required": ["service_result_ref"], "properties": {"service_result_ref": {"type": "string"}}, "additionalProperties": false},
    "d2_state": {"type": "object", "required": ["identity_ref", "role_refs", "consent_state", "workflow_state_ref"], "properties": {"identity_ref": {"type": "string"}, "role_refs": {"type": "array", "items": {"type": "string"}}, "consent_state": {"type": "string"}, "workflow_state_ref": {"type": "string"}}, "additionalProperties": false},
    "d3_coordinate": {"type": "object", "required": ["node_ref", "container", "service_field", "task_ref"], "properties": {"node_ref": {"const": "taiji01"}, "container": {"type": "string"}, "service_field": {"type": "string"}, "module_ref": {"type": "string"}, "task_ref": {"type": "string"}}, "additionalProperties": false},
    "d4_evidence": {"type": "object", "required": ["evidence_refs", "evidence_hashes"], "properties": {"evidence_refs": {"type": "array", "items": {"type": "string"}}, "evidence_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "additionalProperties": false},
    "d5_execution": {"type": "object", "required": ["service_contract_ref", "local_action_ref"], "properties": {"service_contract_ref": {"type": "string"}, "local_action_ref": {"type": "string"}}, "additionalProperties": false},
    "d6_generative_transmission": {"type": "object", "required": ["packet_protocol", "lookup_refs", "reconstruction_conditions", "verification_method"], "properties": {"packet_protocol": {"const": "W7TP-8D-PACKET-NATIVE/1.0"}, "lookup_refs": {"type": "array", "items": {"type": "string"}}, "reconstruction_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "verification_method": {"type": "string", "minLength": 3}}, "additionalProperties": false},
    "d7_risk": {"type": "object", "required": ["hard_risks", "authority_boundary_ok"], "properties": {"hard_risks": {"type": "array", "items": {"type": "string"}}, "authority_boundary_ok": {"type": "boolean"}}, "additionalProperties": false},
    "d8_envelope": {"type": "object", "required": ["identity_ref", "authority_scope", "ttl_seconds", "nonce", "sha256", "protocol", "verifier_ref"], "properties": {"identity_ref": {"type": "string"}, "authority_scope": {"type": "array", "items": {"type": "string"}}, "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "nonce": {"type": "string", "minLength": 8}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "protocol": {"const": "W7TP-8D-PACKET-NATIVE/1.0"}, "verifier_ref": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
