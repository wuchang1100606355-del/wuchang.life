{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W7TP Container Offload Registry",
  "type": "object",
  "required": [
    "registry_version",
    "domain",
    "mode",
    "containers"
  ],
  "properties": {
    "registry_version": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "plan_only"
      ]
    },
    "no_ssh": {
      "type": "boolean"
    },
    "no_restart": {
      "type": "boolean"
    },
    "no_container_move": {
      "type": "boolean"
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "current_host",
          "target_host",
          "class",
          "execution_mode",
          "risk"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "current_host": {
            "type": "string"
          },
          "target_host": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "execution_mode": {
            "type": "string"
          },
          "restart_policy_recommended": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "reason": {
            "type": "string"
          },
          "allowed_mounts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_mounts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
