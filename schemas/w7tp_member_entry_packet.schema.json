{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuchang.life/schemas/w7tp_member_entry_packet.schema.json",
  "title": "W7TP Member Entry Packet",
  "type": "object",
  "required": ["packet_id", "schema_version", "identity_ref", "scenario_ref", "requested_service_ref", "consent_ref", "authorization_ref", "withdrawal_ref", "qualification_ref", "envelope"],
  "properties": {
    "packet_id": {"type": "string", "minLength": 8},
    "schema_version": {"const": "W7TP-MEMBER-ENTRY/1.0"},
    "identity_ref": {"type": "string", "pattern": "^identity:[A-Za-z0-9._-]+$"},
    "scenario_ref": {"type": "string", "pattern": "^scenario:[A-Z0-9_]+$"},
    "requested_service_ref": {"type": "string", "pattern": "^service:[A-Za-z0-9._-]+$"},
    "device_binding_ref": {"type": "string", "pattern": "^device:[A-Za-z0-9._-]+$"},
    "consent_ref": {"type": "string", "pattern": "^consent:[A-Za-z0-9._-]+$"},
    "authorization_ref": {"type": "string", "pattern": "^authorization:[A-Za-z0-9._-]+$"},
    "withdrawal_ref": {"type": "string", "pattern": "^withdrawal:[A-Za-z0-9._-]+$"},
    "qualification_ref": {"type": "string", "pattern": "^qualification:[A-Za-z0-9._-]+$"},
    "envelope": {
      "type": "object",
      "required": ["authority_scope", "consent_state", "revocation_state", "ttl_seconds", "nonce", "protocol", "verifier_ref"],
      "properties": {
        "authority_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "consent_state": {"enum": ["ACTIVE", "LIMITED", "DENIED"]},
        "revocation_state": {"enum": ["CLEAR", "REVOKED"]},
        "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "nonce": {"type": "string", "minLength": 8},
        "protocol": {"const": "W7TP-8D-PACKET-NATIVE/1.0"},
        "verifier_ref": {"type": "string", "minLength": 3}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
