{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuchang.life/schemas/w7tp_identity_authority_packet.schema.json",
  "title": "W7TP Identity Authority Packet",
  "type": "object",
  "required": ["packet_id", "schema_version", "identity_ref", "role_refs", "authority_scope", "consent_state", "revocation_state", "consent_ref", "authorization_ref", "withdrawal_ref", "qualification_ref", "device_binding_ref", "scenario_ref", "envelope_verified"],
  "properties": {
    "packet_id": {"type": "string", "minLength": 8},
    "schema_version": {"const": "W7TP-IDENTITY-AUTHORITY/1.0"},
    "identity_ref": {"type": "string", "pattern": "^identity:[A-Za-z0-9._-]+$"},
    "role_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^role:[A-Za-z0-9._-]+$"}},
    "authority_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "consent_state": {"enum": ["ACTIVE", "LIMITED", "DENIED"]},
    "revocation_state": {"enum": ["CLEAR", "REVOKED"]},
    "consent_ref": {"type": "string", "pattern": "^consent:[A-Za-z0-9._-]+$"},
    "authorization_ref": {"type": "string", "pattern": "^authorization:[A-Za-z0-9._-]+$"},
    "withdrawal_ref": {"type": "string", "pattern": "^withdrawal:[A-Za-z0-9._-]+$"},
    "qualification_ref": {"type": "string", "pattern": "^qualification:[A-Za-z0-9._-]+$"},
    "device_binding_ref": {"type": "string", "pattern": "^device:[A-Za-z0-9._-]+$"},
    "scenario_ref": {"type": "string", "pattern": "^scenario:[A-Z0-9_]+$"},
    "envelope_verified": {"type": "boolean"}
  },
  "additionalProperties": false
}
