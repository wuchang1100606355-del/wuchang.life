{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/cloud_candidate/cloud_candidate_packet.schema.json",
  "title": "Cloud Candidate Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_type",
    "candidate_only",
    "must_not_execute",
    "requires_total_field_verify",
    "d1_intent",
    "d2_state",
    "d3_coordinate",
    "d4_evidence",
    "d5_execution",
    "d6_generative_transmission",
    "d7_risk",
    "d8_envelope"
  ],
  "properties": {
    "schema_version": { "const": "w7tp.cloud_candidate_packet.p0" },
    "packet_type": { "const": "CLOUD_CANDIDATE_PACKET" },
    "candidate_only": { "const": true },
    "must_not_execute": { "const": true },
    "requires_total_field_verify": { "const": true },
    "d1_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_ref", "objective", "not_intent"],
      "properties": {
        "intent_ref": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "not_intent": { "type": "array", "items": { "type": "string" } }
      }
    },
    "d2_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_ref", "input_state", "allowed_output_states"],
      "properties": {
        "state_ref": { "type": "string", "minLength": 1 },
        "input_state": { "type": "string", "minLength": 1 },
        "allowed_output_states": { "type": "array", "items": { "type": "string" } }
      }
    },
    "d3_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_ref", "node_ref", "route_ref", "actor_ref"],
      "properties": {
        "coordinate_ref": { "type": "string", "minLength": 1 },
        "node_ref": { "type": "string", "minLength": 1 },
        "route_ref": { "type": "string", "minLength": 1 },
        "actor_ref": { "type": "string", "minLength": 1 }
      }
    },
    "d4_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_refs", "source_hashes"],
      "properties": {
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "source_hashes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "d5_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_action", "execution_allowed"],
      "properties": {
        "requested_action": { "type": "string", "minLength": 1 },
        "execution_allowed": { "const": false }
      }
    },
    "d6_generative_transmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_packet_ref", "cloud_scope", "raw_data_transferred"],
      "properties": {
        "prompt_packet_ref": { "type": "string", "minLength": 1 },
        "cloud_scope": { "enum": ["candidate_generation_only"] },
        "raw_data_transferred": { "const": false }
      }
    },
    "d7_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_flags", "human_review_required"],
      "properties": {
        "risk_flags": { "type": "array", "items": { "type": "string" } },
        "human_review_required": { "type": "boolean" }
      }
    },
    "d8_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_hash", "ttl_seconds", "verifier_contract_ref", "pollution_guard"],
      "properties": {
        "packet_hash": { "type": "string", "minLength": 16 },
        "ttl_seconds": { "type": "integer", "minimum": 1 },
        "verifier_contract_ref": { "type": "string", "minLength": 1 },
        "pollution_guard": { "const": true }
      }
    }
  }
}
