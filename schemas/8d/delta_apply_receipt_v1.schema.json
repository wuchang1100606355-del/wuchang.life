{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:w7tp:evidence:delta-apply-receipt:1",
  "title": "Differential Transfer D4 Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "RECEIPT_TYPE", "EVIDENCE_SCOPE", "SOURCE_IDENTITY", "TARGET_IDENTITY",
    "OBSERVED_AT", "INPUT_DIGESTS", "OUTPUT_DIGESTS", "LOOKUP_TABLE_REFERENCE",
    "TRANSITION_RULE_REFERENCE", "VERIFIER_ID", "RESULT", "AUTHORITY_SCOPE",
    "LINEAGE_REFERENCE", "CARRIER_RESULT"
  ],
  "properties": {
    "RECEIPT_TYPE": {"const": "DELTA_APPLY_RECEIPT"},
    "EVIDENCE_SCOPE": {"const": "D4_EVIDENCE_ONLY"},
    "SOURCE_IDENTITY": {"type": "string", "minLength": 1},
    "TARGET_IDENTITY": {"type": "string", "minLength": 1},
    "OBSERVED_AT": {"type": "string", "minLength": 1},
    "INPUT_DIGESTS": {"type": "object"},
    "OUTPUT_DIGESTS": {"type": "object"},
    "LOOKUP_TABLE_REFERENCE": {"const": "NOT_APPLICABLE_DIFFERENTIAL_TRANSFER"},
    "TRANSITION_RULE_REFERENCE": {"const": "JSON_TOP_LEVEL_SET_DELETE_V1"},
    "VERIFIER_ID": {"const": "W7TP_DIFFERENTIAL_TRANSFER_VERIFIER_V1"},
    "RESULT": {"enum": ["SUCCESS", "HOLD"]},
    "AUTHORITY_SCOPE": {"const": "NONE"},
    "LINEAGE_REFERENCE": {"type": "string", "minLength": 1},
    "CARRIER_RESULT": {"enum": ["SUCCESS", "HOLD"]}
  }
}
