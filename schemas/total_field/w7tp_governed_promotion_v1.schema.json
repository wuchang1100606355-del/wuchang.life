{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taiji.local/schemas/total_field/w7tp_governed_promotion_v1.schema.json",
  "title": "W7TP governed single-use promotion request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "state", "candidate_artifact_ref", "candidate_sha256",
    "decision_evidence_ref", "decision_evidence_sha256", "total_field_decision",
    "current_canonical_ref", "current_canonical_sha256",
    "target_canonical_ref", "target_canonical_sha256",
    "active_pointer_ref", "active_pointer_sha256", "promotion_output_ref",
    "historical_receipt_reconstruction", "promotion_authorization"
  ],
  "properties": {
    "schema_id": {"const": "W7TP_GOVERNED_PROMOTION_REQUEST_V1"},
    "state": {"const": "REQUEST_SINGLE_PROMOTION"},
    "candidate_artifact_ref": {"$ref": "#/$defs/path"},
    "candidate_sha256": {"$ref": "#/$defs/sha"},
    "decision_evidence_ref": {"$ref": "#/$defs/path"},
    "decision_evidence_sha256": {"$ref": "#/$defs/sha"},
    "total_field_decision": {"const": "ALLOW_CANDIDATE_ACCEPTED"},
    "current_canonical_ref": {"$ref": "#/$defs/path"},
    "current_canonical_sha256": {"$ref": "#/$defs/sha"},
    "target_canonical_ref": {"$ref": "#/$defs/path"},
    "target_canonical_sha256": {"$ref": "#/$defs/sha"},
    "active_pointer_ref": {"$ref": "#/$defs/path"},
    "active_pointer_sha256": {"$ref": "#/$defs/sha"},
    "promotion_output_ref": {"type": "string", "pattern": "^runtime/total_field/promotions/[^/]+$"},
    "historical_receipt_reconstruction": {"const": false},
    "promotion_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "state", "scope", "authority_id", "candidate_sha256",
        "decision_evidence_sha256", "current_canonical_sha256", "target_canonical_sha256",
        "active_pointer_preimage_sha256", "nonce_ref", "issued_at", "expires_at",
        "verifier_ref", "payload_sha256", "signature"
      ],
      "properties": {
        "schema_id": {"const": "W7TP_SINGLE_USE_PROMOTION_AUTHORIZATION_V1"},
        "state": {"const": "AUTHORIZED_SINGLE_PROMOTION"},
        "scope": {"const": "PROMOTE_ACCEPTED_CANDIDATE"},
        "authority_id": {"type": "string", "minLength": 1},
        "candidate_sha256": {"$ref": "#/$defs/sha"},
        "decision_evidence_sha256": {"$ref": "#/$defs/sha"},
        "current_canonical_sha256": {"$ref": "#/$defs/sha"},
        "target_canonical_sha256": {"$ref": "#/$defs/sha"},
        "active_pointer_preimage_sha256": {"$ref": "#/$defs/sha"},
        "nonce_ref": {"type": "string", "pattern": "^nonce_ref:sha256:[0-9a-f]{64}$"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "verifier_ref": {"type": "string", "minLength": 1},
        "payload_sha256": {"$ref": "#/$defs/sha"},
        "signature": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]+={0,2}$"}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
