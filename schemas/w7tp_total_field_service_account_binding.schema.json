{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuchang.life/schemas/w7tp_total_field_service_account_binding.schema.json",
  "title": "W7TP Total Field Google Service Account Binding",
  "type": "object",
  "required": ["binding_id", "schema_version", "channel", "connector", "runtime_identity", "auth_mode", "principal_ref", "service_account_key_file_policy", "super_admin_role", "authority_boundary", "candidate_return_boundary"],
  "properties": {
    "binding_id": {"type": "string", "pattern": "^binding:total-field:[A-Za-z0-9._-]+$"},
    "schema_version": {"const": "W7TP-TOTAL-FIELD-SERVICE-ACCOUNT-BINDING/1.0"},
    "channel": {"const": "TOTAL_FIELD"},
    "connector": {"const": "VERTEX_AI_GEMINI_CANDIDATE"},
    "runtime_identity": {"const": "DEDICATED_SERVICE_ACCOUNT"},
    "auth_mode": {"enum": ["ADC_IMPERSONATION", "ADC"]},
    "principal_ref": {"type": "string", "pattern": "^service-account-ref:[A-Za-z0-9._-]+$"},
    "impersonation_target_ref": {"type": "string", "pattern": "^service-account-ref:[A-Za-z0-9._-]+$"},
    "service_account_key_file_policy": {"const": "PREFER_NONE"},
    "super_admin_role": {"const": "BOOTSTRAP_AND_APPROVAL_ONLY"},
    "authority_boundary": {
      "type": "object",
      "required": ["cloud_connector_identity_only", "governance_authority", "xiaoj_identity", "owner_intent", "member_identity", "final_decision"],
      "properties": {
        "cloud_connector_identity_only": {"const": true},
        "governance_authority": {"const": false},
        "xiaoj_identity": {"const": false},
        "owner_intent": {"const": false},
        "member_identity": {"const": false},
        "final_decision": {"const": false}
      },
      "additionalProperties": false
    },
    "candidate_return_boundary": {
      "type": "object",
      "required": ["execution_authority", "verification_required"],
      "properties": {
        "execution_authority": {"const": false},
        "verification_required": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"auth_mode": {"const": "ADC_IMPERSONATION"}}},
      "then": {"required": ["impersonation_target_ref"]}
    }
  ],
  "additionalProperties": false
}
