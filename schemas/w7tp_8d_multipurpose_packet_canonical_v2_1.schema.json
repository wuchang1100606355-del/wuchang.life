            "LOOKUP",
            "REFERENCE_RESOLUTION",
            "STATE_TRANSITION"
          ]
        },
        "model_output_role": {
          "const": "CANDIDATE_EVIDENCE_ONLY"
        }
      }
    },
    "verification": {
      "oneOf": [
        {
          "$ref": "#/$defs/l1ExactByteVerification"
