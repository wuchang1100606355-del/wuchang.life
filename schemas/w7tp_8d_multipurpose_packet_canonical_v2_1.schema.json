          "enum": [
            "UNSEALED_CANDIDATE",
            "SEALED_BY_LOCAL_TOTAL_FIELD"
          ]
        },
        "final_seal_authority": {
          "const": "LOCAL_TOTAL_FIELD"
        }
      }
    }
  }
}
