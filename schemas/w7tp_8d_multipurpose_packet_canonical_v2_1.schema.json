        "generation_rule_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
        },
        "reconstruction_condition_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
        },
        "equivalent_state_rule_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
