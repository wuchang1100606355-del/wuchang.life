        "irreversible": {
          "const": true
        },
        "reversible_identity": {
          "const": false
        },
        "database_primary_key": {
          "const": false
        },
        "floating_embedding": {
          "const": false
        }
      }
    },
    "adiSystemLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_kind",
        "owner_authority_ref",
        "namespace",
        "logical_time",
        "packet_lineage_refs",
        "state_transition_ref",
        "evidence_refs"
