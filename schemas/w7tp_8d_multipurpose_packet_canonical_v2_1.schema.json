        "changed_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "D1_INTENT",
              "D2_STATE",
              "D3_COORDINATE",
              "D4_EVIDENCE",
              "D5_EXECUTION",
              "D6_GENERATIVE_TRANSMISSION",
              "D7_RISK_QUARANTINE",
              "D8_ENVELOPE_VERIFICATION"
            ]
          }
        },
        "transition_evidence_refs": {
          "$ref": "#/$defs/nonEmptyRefArray"
        }
      }
    },
    "verificationDecision": {
      "enum": [
        "PASS",
        "HOLD",
        "BLOCK"
      ]
    },
    "l1ExactByteVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "method_ref",
        "contract_ref",
        "decision",
        "raw_sha256",
        "byte_length",
        "hash_scope"
      ],
      "properties": {
        "mode": {
          "const": "L1_EXACT_BYTE"
        },
        "method_ref": {
          "$ref": "#/$defs/typedRef"
        },
        "contract_ref": {
          "$ref": "#/$defs/typedRef"
        },
        "decision": {
          "$ref": "#/$defs/verificationDecision"
        },
        "raw_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "hash_scope": {
          "const": "TARGET_RAW_BYTES"
        }
      }
    },
    "l2EffectEquivalentVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "method_ref",
        "contract_ref",
        "decision",
        "effect_contract_ref",
        "comparison_fields",
        "evidence_refs",
        "local_verifier_ref"
