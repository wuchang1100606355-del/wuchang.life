    "typedRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*:[^\\s]+$"
    },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/typedRef"
