{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuchang.life/schemas/w7tp_capability_packet.schema.json",
  "title": "W7TP Capability Packet",
  "type": "object",
  "required": ["capability_ref", "packet_type", "schema_version", "domain_code", "language_code", "compatibility_profile", "source_refs", "payload_refs", "reconstruction_spec", "verification_method", "sha256"],
  "properties": {
    "capability_ref": {"type": "string", "pattern": "^(capability:[A-Za-z0-9._-]+|CAP_[A-Z0-9_]+)$"},
    "packet_type": {"enum": ["LANGUAGE_CAPABILITY_PACKET", "CODE_COMPONENT_PACKET", "RESEARCH_CANDIDATE_PACKET", "PROFESSIONAL_RULE_PACKET"]},
    "schema_version": {"const": "W7TP-CAPABILITY/1.0"},
    "domain_code": {"type": "string"},
    "language_code": {"type": "string"},
    "compatibility_profile": {"type": "string"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "payload_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reconstruction_spec": {"type": "object", "required": ["mode", "conditions", "effect_contract_ref"], "properties": {"mode": {"enum": ["L1_FULL", "L2_EQUIVALENT", "L3_CANDIDATE"]}, "conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "effect_contract_ref": {"type": "string"}}, "additionalProperties": false},
    "verification_method": {"type": "string", "minLength": 3},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
