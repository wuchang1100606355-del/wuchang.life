{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuchang.life/schemas/w7tp_total_field_reconstruct_isolated_review_receipt_v2.schema.json",
  "title": "W7TP Total Field Reconstruct Isolated Review Receipt V2",
  "type": "object",
  "required": [
    "contract", "receipt_id", "reviewer_version", "request_sha256", "scope_sha256",
    "decision_sha256", "review_evidence_sha256", "final_decision", "state",
    "review_request_single_use_consumed", "execution_single_use_consumed", "replay_disposition",
    "canary_started", "receipt_hash_algorithm", "receipt_sha256"
  ],
  "properties": {
    "contract": {"const": "W7TP-TOTAL-FIELD-RECONSTRUCT-ISOLATED-REVIEW-RECEIPT/2.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "reviewer_version": {"const": "w7tp-reconstruct-isolated-reviewer/2.0-candidate"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "scope_sha256": {"$ref": "#/$defs/sha256"},
    "decision_sha256": {"$ref": "#/$defs/sha256"},
    "review_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "final_decision": {"enum": ["ALLOW", "DENY", "HOLD"]},
    "state": {"enum": ["PASS", "REJECT", "HOLD"]},
    "review_request_single_use_consumed": {"const": true},
    "execution_single_use_consumed": {"const": false},
    "replay_disposition": {"const": "UNCONSUMED_FOR_EXECUTION"},
    "canary_started": {"const": false},
    "receipt_hash_algorithm": {"const": "SHA256_CANONICAL_JSON_EXCLUDING_RECEIPT_SHA256/1.0"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
