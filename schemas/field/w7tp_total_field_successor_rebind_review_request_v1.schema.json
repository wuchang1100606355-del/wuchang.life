{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuchang.life/schemas/w7tp_total_field_successor_rebind_review_request_v1.schema.json",
  "title": "W7TP Total Field Successor Rebind Review Request V1",
  "type": "object",
  "required": [
    "schema_version",
    "packet_type",
    "request_id",
    "run_id",
    "canonical_ref",
    "candidate_root",
    "manifest_sha256",
    "source_path_ref",
    "symbol_ref",
    "predecessor_commit",
    "predecessor_sha256",
    "current_commit",
    "current_sha256",
    "change_provenance",
    "breakpoint_reachability_contract",
    "nonce",
    "created_at",
    "expires_at",
    "replay_guard",
    "authority_pointer_ref",
    "authority_pointer_sha256",
    "founder_authorization_ref",
    "founder_authorization_sha256",
    "requested_decision",
    "contract_mode",
    "request_self_hash_algorithm",
    "request_self_sha256",
    "non_execution_assertions"
  ],
  "properties": {
    "schema_version": {"const": "W7TP-TOTAL-FIELD-SUCCESSOR-REBIND-REVIEW-REQUEST/1.0"},
    "packet_type": {"const": "TOTAL_FIELD_SUCCESSOR_REBIND_REVIEW_REQUEST"},
    "request_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "canonical_ref": {"type": "string", "minLength": 1},
    "candidate_root": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_path_ref": {"const": "core/adi_native/verifier.py"},
    "symbol_ref": {"const": "total_field_candidate_decision"},
    "predecessor_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "predecessor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "current_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "current_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "change_provenance": {"type": "string", "minLength": 1},
    "breakpoint_reachability_contract": {"const": "BREAKPOINT_REACHABILITY_CONTRACT_V1"},
    "nonce": {"type": "string", "pattern": "^nonce:sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "replay_guard": {
      "type": "object",
      "required": ["single_use", "domain", "ledger_ref", "on_replay"],
      "properties": {
        "single_use": {"const": true},
        "domain": {"type": "string", "minLength": 1},
        "ledger_ref": {"type": "string", "minLength": 1},
        "on_replay": {"const": "HOLD_SUCCESSOR_REBIND_REVIEW"}
      },
      "additionalProperties": false
    },
    "authority_pointer_ref": {"type": "string", "minLength": 1},
    "authority_pointer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "founder_authorization_ref": {"type": "string", "minLength": 1},
    "founder_authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_decision": {"const": "SUCCESSOR_REBIND_APPROVED"},
    "contract_mode": {"enum": ["CANDIDATE_CONTRACT_ONLY", "FORMAL_REVIEW"]},
    "request_self_hash_algorithm": {"const": "SHA256_CANONICAL_JSON_EXCLUDING_REQUEST_SELF_SHA256/1.0"},
    "request_self_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "non_execution_assertions": {
      "type": "object",
      "required": [
        "core_write",
        "canonical_change",
        "pointer_change",
        "git_write",
        "db_write",
        "deploy",
        "restart",
        "network_change",
        "formal_decision_creation",
        "formal_seal_creation"
      ],
      "properties": {
        "core_write": {"const": false},
        "canonical_change": {"const": false},
        "pointer_change": {"const": false},
        "git_write": {"const": false},
        "db_write": {"const": false},
        "deploy": {"const": false},
        "restart": {"const": false},
        "network_change": {"const": false},
        "formal_decision_creation": {"const": false},
        "formal_seal_creation": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
