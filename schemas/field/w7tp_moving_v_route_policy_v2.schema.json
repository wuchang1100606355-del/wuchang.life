  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_field_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_pointer",
        "target_pointer",
        "transform",
        "verification_state",
        "note"
      ],
      "properties": {
        "source_pointer": {
          "type": "string",
          "pattern": "^/.*$",
          "maxLength": 512
        },
        "target_pointer": {
          "type": "string",
          "pattern": "^/.*$",
          "maxLength": 512
        },
        "transform": {
          "enum": [
            "EXACT_COPY",
            "CANONICALIZED_ENUM",
            "DERIVED_CONSERVATIVE_DEFAULT",
            "NOT_MAPPED_HOLD"
          ]
        },
        "verification_state": {
          "enum": [
            "VERIFIED_STATIC_SOURCE_BINDING",
            "ADAPTER_REQUIRED/HOLD"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "anti_replay_source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source_sha256",
        "implementation_kind",
        "observed_capabilities",
        "component_state",
        "moving_v_binding_state",
        "gap"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "implementation_kind": {
          "enum": [
            "PERSISTENT_NONCE_LEDGER",
            "DLQ_ROUTER",
            "MOCK_DLQ_POLICY",
            "DLQ_REPLAY_EXECUTOR",
            "REPLAY_TEST"
          ]
        },
        "observed_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "SQLITE_PERSISTENCE",
              "NONCE_PRIMARY_KEY",
              "PACKET_HASH_BINDING",
              "TTL_CLEANUP",
              "ATOMIC_INSERT_OR_IGNORE",
              "WAL_FULL_SYNC",
              "REPLAY_AFTER_RESTART_TEST",
              "TWO_CONNECTION_SINGLE_CONSUMER_TEST",
              "DLQ_REASON",
              "DLQ_PAYLOAD_HASH",
              "HUMAN_REVIEW_HOLD",
              "IN_MEMORY_MOCK_ONLY",
              "MOVE_RETRY_LOOP"
            ]
          }
        },
        "component_state": {
          "enum": [
            "DIRECT_NATIVE",
            "ADAPTER_REQUIRED"
          ]
        },
        "moving_v_binding_state": {
          "const": "ADAPTER_REQUIRED"
        },
        "gap": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "uint_dec": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "positive_uint_dec": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "ns_dec": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "bytes_dec": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
