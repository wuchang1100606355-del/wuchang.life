{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w7tp.local/schemas/field/w7tp_moving_v_route_policy_v2.schema.json",
  "title": "W7TP Moving-V Route Policy V2",
  "description": "Closed, evidence-bound policy for Moving-V routing across the FILE/PREDICTION lifecycle. All uint, nanosecond, and byte quantities are decimal strings for cross-runtime precision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_version",
    "contract_id",
    "status",
    "mode",
    "time_encoding",
    "instance_provenance",
    "authority",
    "lifecycle_policy",
    "moving_v_geometry",
    "route_proof_policy",
    "error_branch_invalidation_policy",
    "watermark_policy",
    "materialization_policy",
    "memory_budget_policy",
    "ux_gate_policy",
    "false_miss_policy",
    "router_dlq_anti_replay_policy",
    "allowed_actions",
    "zero_tolerance_metrics"
  ],
  "properties": {
    "$schema": {
      "const": "https://w7tp.local/schemas/field/w7tp_moving_v_route_policy_v2.schema.json"
    },
    "contract_version": {
      "const": "W7TP-MOVING-V-ROUTE-POLICY/2.0"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.:-]{7,127}$"
    },
    "status": {
      "enum": [
        "CANDIDATE_ONLY",
        "SHADOW_AUTHORIZED",
        "RAM_CANARY_AUTHORIZED",
        "FORMAL_AUTHORIZED"
      ]
    },
    "mode": {
      "enum": [
        "STATIC_VALIDATION_ONLY",
        "READ_ONLY_SHADOW",
        "REVERSIBLE_RAM_CANARY",
        "FORMAL_RUNTIME"
      ]
    },
    "time_encoding": {
      "const": "UNIX_EPOCH_NANOSECONDS_AS_UNSIGNED_DECIMAL_STRING"
    },
    "instance_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_role",
        "source_contract_ref",
        "source_contract_sha256",
        "source_scope",
        "mapping_version",
        "mappings",
        "unmapped_source_namespace_state",
        "runtime_integration_state",
        "binding_algorithm",
        "binding_scope",
        "binding_sha256"
      ],
      "properties": {
        "instance_role": {
          "const": "SCHEMA_VALID_POLICY_INSTANCE"
        },
        "source_contract_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_scope": {
          "const": "SELECTED_DECLARATIVE_FIELDS_ONLY"
        },
        "mapping_version": {
          "const": "W7TP-MOVING-V-CONTRACT-CONFIG-TO-POLICY-INSTANCE/2.0"
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/policy_field_mapping"
          }
        },
        "unmapped_source_namespace_state": {
          "const": "NOT_ASSERTED_AS_POLICY_INSTANCE"
        },
        "runtime_integration_state": {
          "const": "ADAPTER_REQUIRED/HOLD"
        },
        "binding_algorithm": {
          "const": "SHA-256"
        },
        "binding_scope": {
          "const": "UTF8_JSON_SORTED_KEYS_NO_WHITESPACE_OF_SOURCE_REF_SHA_SCOPE_MAPPING_VERSION_AND_MAPPINGS"
        },
        "binding_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_authority",
        "runtime_authority_state",
        "live_action_authority_receipt_required",
        "canonical_action",
        "hard_delete_canonical_allowed",
        "self_approval_allowed"
      ],
      "properties": {
        "decision_authority": {
          "const": "TOTAL_FIELD"
        },
        "runtime_authority_state": {
          "enum": [
            "NOT_AUTHORIZED",
            "SHADOW_ONLY",
            "RAM_CANARY_ONLY",
            "FORMAL_RUNTIME"
          ]
        },
        "live_action_authority_receipt_required": {
          "const": true
        },
        "canonical_action": {
          "const": "RETAIN"
        },
        "hard_delete_canonical_allowed": {
          "const": false
        },
        "self_approval_allowed": {
          "const": false
        }
      }
    },
    "lifecycle_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_basis",
        "stages",
        "stage_field",
        "stage_entered_at_field",
        "stage_observed_at_field",
        "stage_sequence_field",
        "stage_state_hash_field",
        "time_domain_field",
        "logical_time_field",
        "schedule_reference_field",
        "job_reference_field",
        "transition_receipt_required",
        "initial_stage_transition_receipt_required",
        "transition_receipt_schema_version",
        "allowed_transitions",
        "transition_pre_state_hash_required",
        "transition_post_state_hash_required",
        "monotonicity_invariants",
        "stage_regression_policy",
        "scheduled_or_running_release_accounting",
        "completion_receipt_required",
        "completed_ownership_resolution_required"
      ],
      "properties": {
        "time_basis": {
          "const": "FILE_PREDICTION_LIFECYCLE"
        },
        "stages": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": "PREDICTED_NOT_GENERATED"
            },
            {
              "const": "GENERATION_SCHEDULED_OR_RUNNING"
            },
            {
              "const": "GENERATION_COMPLETED"
            }
          ],
          "items": false
        },
        "stage_field": {
          "const": "stage"
        },
        "stage_entered_at_field": {
          "const": "stage_entered_at_ns"
        },
        "stage_observed_at_field": {
          "const": "stage_observed_at_ns"
        },
        "stage_sequence_field": {
          "const": "stage_sequence_uint_dec"
        },
        "stage_state_hash_field": {
          "const": "stage_state_sha256"
        },
        "time_domain_field": {
          "const": "time_domain_id"
        },
        "logical_time_field": {
          "const": "logical_time_uint_dec"
        },
        "schedule_reference_field": {
          "const": "schedule_ref"
        },
        "job_reference_field": {
          "const": "job_ref"
        },
        "transition_receipt_required": {
          "const": true
        },
        "initial_stage_transition_receipt_required": {
          "const": false
        },
        "transition_receipt_schema_version": {
          "const": "W7TP-MOVING-V-LIFECYCLE-TRANSITION-RECEIPT/2.0"
        },
        "allowed_transitions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PREDICTED_NOT_GENERATED->GENERATION_SCHEDULED_OR_RUNNING",
              "GENERATION_SCHEDULED_OR_RUNNING->GENERATION_COMPLETED"
            ]
          }
        },
        "transition_pre_state_hash_required": {
          "const": true
        },
        "transition_post_state_hash_required": {
          "const": true
        },
        "monotonicity_invariants": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "STAGE_SEQUENCE_STRICTLY_INCREASES_ON_TRANSITION",
              "LOGICAL_TIME_STRICTLY_INCREASES_ON_TRANSITION",
              "STAGE_ENTERED_AT_NOT_AFTER_STAGE_OBSERVED_AT",
              "STAGE_OBSERVED_AT_NOT_AFTER_INGEST_TIME",
              "TRANSITION_PRE_AND_POST_STATE_HASHES_MATCH"
            ]
          }
        },
        "stage_regression_policy": {
          "const": "HOLD_AND_INVALIDATE_ROUTE_BRANCH"
        },
        "scheduled_or_running_release_accounting": {
          "const": "FORBIDDEN_UNTIL_CANCELLATION_RECEIPT_AND_ALLOCATOR_COMMIT_OBSERVATION"
        },
        "completion_receipt_required": {
          "const": true
        },
        "completed_ownership_resolution_required": {
          "const": true
        }
      }
    },
    "moving_v_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_epoch_id",
        "prediction_epoch_id",
        "route_epoch_id",
        "membership_epoch_id",
        "time_domain_id",
        "route_graph_root_sha256",
        "route_ruleset_root_sha256",
        "apex_semantics",
        "opening_direction",
        "inside_v_semantics",
        "side_semantics",
        "behind_apex_semantics",
        "distance_input",
        "apex_time_ns",
        "current_guard_ns",
        "clock_uncertainty_ns",
        "past_grace_ns",
        "future_horizon_ns",
        "interpolation",
        "envelope",
        "classification_states",
        "runtime_invariants"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_epoch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "prediction_epoch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "route_epoch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "membership_epoch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "time_domain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "route_graph_root_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "route_ruleset_root_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "apex_semantics": {
          "const": "ALIGNED_CURRENT_TIME"
        },
        "opening_direction": {
          "const": "FUTURE"
        },
        "inside_v_semantics": {
          "const": "FUTURE_PRELOAD_PROTECTED"
        },
        "side_semantics": {
          "const": "FUTURE_PREDICTED_MISS_ROUTE_BRANCH"
        },
        "behind_apex_semantics": {
          "const": "PAST_HOLD_OR_ELIGIBLE_AFTER_WATERMARK_AND_GATES"
        },
        "distance_input": {
          "const": "FOUNDER_NATIVE_ADI_DELTA_F_UINT_WITH_PROOF_RECEIPT"
        },
        "apex_time_ns": {
          "$ref": "#/$defs/ns_dec"
        },
        "current_guard_ns": {
          "$ref": "#/$defs/ns_dec"
        },
        "clock_uncertainty_ns": {
          "$ref": "#/$defs/ns_dec"
        },
        "past_grace_ns": {
          "$ref": "#/$defs/ns_dec"
        },
        "future_horizon_ns": {
          "$ref": "#/$defs/ns_dec"
        },
        "interpolation": {
          "enum": [
            "LEFT_STEP",
            "PIECEWISE_LINEAR_INTEGER_FLOOR"
          ]
        },
        "envelope": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/envelope_knot"
          }
        },
        "classification_states": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PAST_HOLD",
              "PAST_ELIGIBLE",
              "CURRENT_GUARD",
              "FUTURE_PROTECTED",
              "FUTURE_PREDICTED_MISS",
              "OUT_OF_HORIZON",
              "OUTSIDE_MANAGED_ENVELOPE_HOLD",
              "UNALIGNED_HOLD"
            ]
          }
        },
        "runtime_invariants": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ENVELOPE_OFFSETS_STRICTLY_INCREASE",
              "PROTECTED_RADIUS_NON_DECREASING",
              "CANDIDATE_RADIUS_NON_DECREASING",
              "PROTECTED_RADIUS_NOT_GREATER_THAN_CANDIDATE_RADIUS",
              "SIDE_CLEANUP_WIDTH_NON_INCREASING",
              "FINAL_OFFSET_EQUALS_FUTURE_HORIZON",
              "APEX_AND_WATERMARK_NEVER_REGRESS",
              "UNKNOWN_OR_CONFLICTED_INPUT_HOLDS"
            ]
          }
        }
      }
    },
    "route_proof_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_required",
        "proof_schema_version",
        "proof_types",
        "distance_field",
        "canonical_path_required",
        "canonical_path_hash_required",
        "materialization_content_binding_required",
        "prediction_and_route_epoch_binding_required",
        "invalidation_branch_match_required",
        "descendant_closure_proof_required",
        "binds",
        "generic_geometry_proxy_allowed",
        "similarity_proxy_allowed",
        "missing_or_invalid_proof_action",
        "invalidating_conditions"
      ],
      "properties": {
        "proof_required": {
          "const": true
        },
        "proof_schema_version": {
          "const": "W7TP-MOVING-V-ROUTE-PROOF-RECEIPT/2.0"
        },
        "proof_types": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "REACHABLE_PATH_PROOF",
              "ROUTE_PREDICTION_RECEIPT",
              "ROUTE_EXCLUSION_PROOF",
              "PREDICTION_INVALIDATION_PROOF"
            ]
          }
        },
        "distance_field": {
          "const": "delta_f_uint_dec"
        },
        "canonical_path_required": {
          "const": false
        },
        "canonical_path_hash_required": {
          "const": false
        },
        "materialization_content_binding_required": {
          "const": true
        },
        "prediction_and_route_epoch_binding_required": {
          "const": true
        },
        "invalidation_branch_match_required": {
          "const": true
        },
        "descendant_closure_proof_required": {
          "const": true
        },
        "binds": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": {
            "enum": [
              "RECORD_ID",
              "MATERIALIZATION_ID",
              "CONTENT_SHA256",
              "POLICY_ID",
              "POLICY_EPOCH_ID",
              "PREDICTION_EPOCH_ID",
              "ROUTE_EPOCH_ID",
              "ROUTE_GRAPH_ROOT_SHA256",
              "ROUTE_RULESET_ROOT_SHA256",
              "START_STATE_ROOT_SHA256",
              "TARGET_STATE_OR_PREDICATE_SHA256",
              "LIFECYCLE_STAGE_STATE_SHA256",
              "LIFECYCLE_TRANSITION_RECEIPT",
              "NEED_TIME_RECEIPT",
              "ADI_PROOF_RECEIPT",
              "WATERMARK_MEMBERSHIP_RECEIPT",
              "BRANCH_ID_FOR_INVALIDATION",
              "DESCENDANT_CLOSURE_ROOT_AND_RECEIPT"
            ]
          }
        },
        "generic_geometry_proxy_allowed": {
          "const": false
        },
        "similarity_proxy_allowed": {
          "const": false
        },
        "missing_or_invalid_proof_action": {
          "const": "HOLD_AND_INVALIDATE_ROUTE_BRANCH"
        },
        "invalidating_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/invalidation_reason"
          }
        }
      }
    },
    "error_branch_invalidation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "canonical_action",
        "scheduled_or_running_is_released",
        "release_accounting_requires_commit_receipt",
        "predicted_not_generated",
        "generation_scheduled_or_running",
        "generation_completed"
      ],
      "properties": {
        "scope": {
          "const": "INVALIDATED_ROUTE_BRANCH_ONLY"
        },
        "canonical_action": {
          "const": "RETAIN"
        },
        "scheduled_or_running_is_released": {
          "const": false
        },
        "release_accounting_requires_commit_receipt": {
          "const": true
        },
        "predicted_not_generated": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage",
            "required_action",
            "required_receipts",
            "release_accounting"
          ],
          "properties": {
            "stage": {
              "const": "PREDICTED_NOT_GENERATED"
            },
            "required_action": {
              "const": "CANCEL_PREDICTED_CANDIDATE"
            },
            "required_receipts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "const": "ROUTE_INVALIDATION_RECEIPT"
                }
              ],
              "items": false
            },
            "release_accounting": {
              "const": "ZERO_MATERIALIZED_BYTES"
            }
          }
        },
        "generation_scheduled_or_running": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage",
            "required_action",
            "required_receipts",
            "accepted_cancellation_outcomes",
            "required_worker_fence_state",
            "release_accounting"
          ],
          "properties": {
            "stage": {
              "const": "GENERATION_SCHEDULED_OR_RUNNING"
            },
            "required_action": {
              "const": "REQUEST_GENERATION_CANCELLATION"
            },
            "required_receipts": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "CANCELLATION_REQUEST_RECEIPT",
                  "CANCELLATION_RESULT_RECEIPT",
                  "WORKER_FENCE_QUIESCED_RECEIPT",
                  "ALLOCATOR_COMMIT_OBSERVATION"
                ]
              }
            },
            "accepted_cancellation_outcomes": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "CANCELLED_BEFORE_START",
                  "CANCELLED_DURING_RUN"
                ]
              }
            },
            "required_worker_fence_state": {
              "const": "QUIESCED"
            },
            "release_accounting": {
              "const": "FORBIDDEN_BEFORE_VERIFIED_CANCELLATION_AND_ALLOCATOR_COMMIT"
            }
          }
        },
        "generation_completed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage",
            "ownership_required",
            "exclusive_non_canonical_action",
            "shared_or_canonical_action",
            "required_receipts",
            "release_accounting"
          ],
          "properties": {
            "stage": {
              "const": "GENERATION_COMPLETED"
            },
            "ownership_required": {
              "const": true
            },
            "exclusive_non_canonical_action": {
              "const": "DELETE_NONCANONICAL_DERIVED_MATERIALIZATION"
            },
            "shared_or_canonical_action": {
              "const": "DETACH_BRANCH_REFERENCE_RETAIN_CANONICAL"
            },
            "required_receipts": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "COMPLETION_RECEIPT",
                  "BRANCH_DELETION_OR_DETACH_RECEIPT",
                  "MATERIALIZATION_COMMIT_RECEIPT"
                ]
              }
            },
            "release_accounting": {
              "const": "ONLY_FROM_VERIFIED_COMMIT_RECEIPT"
            }
          }
        }
      }
    },
