        "PRELOAD_HIT_RATE_BP",
        "FALSE_MISS_RATE_BP",
        "RECONSTRUCTION_PASS_RATE_BP",
        "OOM_COUNT",
        "SWAP_THRASH_COUNT",
        "PROTECTED_EVICTION_COUNT",
        "RECONSTRUCTION_HASH_MISMATCH_COUNT",
        "PEAK_RAM_BYTES",
