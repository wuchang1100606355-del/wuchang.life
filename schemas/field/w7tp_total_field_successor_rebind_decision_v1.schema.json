{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuchang.life/schemas/w7tp_total_field_successor_rebind_decision_v1.schema.json",
  "title": "W7TP Total Field Successor Rebind Decision V1",
  "type": "object",
  "required": [
    "schema_version",
    "packet_type",
    "decision_id",
    "request_id",
    "run_id",
    "reviewed_at",
    "state",
    "decision",
    "reason_codes",
    "request_sha256",
    "manifest_sha256",
    "predecessor_commit",
    "predecessor_sha256",
    "current_commit",
    "current_sha256",
    "authority_pointer_ref",
    "authority_pointer_sha256",
    "formal",
    "seal_eligible",
    "core_landing",
    "decision_self_hash_algorithm",
    "decision_sha256"
  ],
  "properties": {
    "schema_version": {"const": "W7TP-TOTAL-FIELD-SUCCESSOR-REBIND-DECISION/1.0"},
    "packet_type": {"const": "TOTAL_FIELD_SUCCESSOR_REBIND_DECISION"},
    "decision_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["PASS_SUCCESSOR_REBIND_REVIEW", "REJECT_SUCCESSOR_REBIND_REVIEW", "HOLD_SUCCESSOR_REBIND_REVIEW"]},
    "decision": {"enum": ["SUCCESSOR_REBIND_APPROVED", "SUCCESSOR_REBIND_REJECTED", "HOLD_SUCCESSOR_REBIND_REVIEW"]},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predecessor_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "predecessor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "current_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "current_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_pointer_ref": {"type": "string", "minLength": 1},
    "authority_pointer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "formal": {"type": "boolean"},
    "seal_eligible": {"type": "boolean"},
    "core_landing": {"const": "HOLD_PENDING_SEPARATE_AUTHORIZATION"},
    "decision_self_hash_algorithm": {"const": "SHA256_CANONICAL_JSON_EXCLUDING_DECISION_SHA256/1.0"},
    "decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
