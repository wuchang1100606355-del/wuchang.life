{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuchang.life/schemas/field/w7tp_8d_state_field_metric_tensor_packet.schema.json",
  "title": "W7TP 8D State Field Metric Tensor Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "version",
    "primary_technology",
    "final_authority",
    "packet_vector",
    "metric_tensor",
    "reference_state",
    "distance_function",
    "generative_transport",
    "adi_5d_metric_ref",
    "adi_policy",
    "internal_communication_policy",
    "total_field_verifier",
    "hard_risk_policy",
    "organization_container_policy",
    "xiaoj_translation_policy",
    "cloud_candidate_policy",
    "redteam_status",
    "human_review_required",
    "total_field_decision"
  ],
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "W7TP_8D_STATE_FIELD_METRIC_TENSOR_PACKET_CANDIDATE",
        "W7TP_8D_STATE_FIELD_METRIC_TENSOR_PACKET_PASS",
        "W7TP_8D_STATE_FIELD_METRIC_TENSOR_PACKET_HOLD",
        "W7TP_8D_STATE_FIELD_METRIC_TENSOR_PACKET_BLOCK"
      ]
    },
    "version": {
      "const": "1.0.0"
    },
    "primary_technology": {
      "const": "8D_STATE_FIELD_PACKET"
    },
    "final_authority": {
      "const": "total_field_verifier"
    },
    "packet_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notation",
        "intent_field",
        "state_field",
        "coordinate_field",
        "evidence_field",
        "execution_field",
        "generative_transport_field",
        "risk_field",
        "envelope_field"
      ],
      "properties": {
        "notation": {
          "const": "P_8D=(F_I,F_S,F_C,F_Ev,F_X,F_GT,F_R,F_Env)"
        },
        "intent_field": {
          "$ref": "#/$defs/state_field_node"
        },
        "state_field": {
          "$ref": "#/$defs/state_field_node"
        },
        "coordinate_field": {
          "$ref": "#/$defs/state_field_node"
        },
        "evidence_field": {
          "$ref": "#/$defs/state_field_node"
        },
        "execution_field": {
          "$ref": "#/$defs/execution_field"
        },
        "generative_transport_field": {
          "$ref": "#/$defs/generative_transport_field"
        },
        "risk_field": {
          "$ref": "#/$defs/risk_field"
        },
        "envelope_field": {
          "$ref": "#/$defs/envelope_field"
        }
      }
    },
    "metric_tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notation",
        "diagonal_components",
        "numeric_weights_public"
      ],
      "properties": {
        "notation": {
          "const": "G_8D=diag(g_I,g_S,g_C,g_Ev,g_X,g_GT,g_R,g_Env)"
        },
        "diagonal_components": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "g_I",
              "g_S",
              "g_C",
              "g_Ev",
              "g_X",
              "g_GT",
              "g_R",
              "g_Env"
            ]
          },
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true
        },
        "numeric_weights_public": {
          "const": false
        }
      }
    },
    "reference_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notation",
        "local_total_field_baseline_ref"
      ],
      "properties": {
        "notation": {
          "const": "R_8D"
        },
        "local_total_field_baseline_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "distance_function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notation",
        "hard_risk_overrides_distance"
      ],
      "properties": {
        "notation": {
          "const": "Delta(P,R)=sqrt((P_8D-R_8D)^T G_8D (P_8D-R_8D))"
        },
        "hard_risk_overrides_distance": {
          "const": true
        }
      }
    },
    "generative_transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "packet_ref",
        "state_ref",
        "evidence_ref",
        "reconstruction_condition",
        "equivalent_state_condition",
        "verification_condition",
        "full_data_required",
        "plaintext_required",
        "equivalent_state_verifiable",
        "total_field_final_authority"
      ],
      "properties": {
        "mode": {
          "const": "incomplete_information_equivalent_state_transmission"
        },
        "packet_ref": {
          "type": "string",
          "minLength": 1
        },
        "state_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "reconstruction_condition": {
          "type": "string",
          "minLength": 1
        },
        "equivalent_state_condition": {
          "type": "string",
          "minLength": 1
        },
        "verification_condition": {
          "type": "string",
          "minLength": 1
        },
        "full_data_required": {
          "const": false
        },
        "plaintext_required": {
          "const": false
        },
        "equivalent_state_verifiable": {
          "const": true
        },
        "total_field_final_authority": {
          "const": true
        }
      }
    },
    "adi_5d_metric_ref": {
      "type": "string",
      "pattern": "^ADI_5D_METRIC_REF:"
    },
    "adi_policy": {
      "const": "ADI_5D_METRIC_INDEX_ONLY_NOT_8D_TABLE"
    },
    "internal_communication_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notation",
        "receiver_reconstructs",
        "total_field_verifies"
      ],
      "properties": {
        "notation": {
          "const": "COMM(A,B)=GT(P_8D)"
        },
        "receiver_reconstructs": {
          "const": "Receiver(B).Reconstruct(GT(P_8D))->P'_8D"
        },
        "total_field_verifies": {
          "const": "TotalField.Verify(P'_8D)->PASS/HOLD/WARN/BLOCK"
        }
      }
    },
    "total_field_verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_authority",
        "decisions"
      ],
      "properties": {
        "final_authority": {
          "const": "total_field_verifier"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "PASS",
              "HOLD",
              "WARN",
              "BLOCK"
            ]
          },
          "minItems": 4,
          "uniqueItems": true
        }
      }
    },
    "hard_risk_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hard_risk_direct_block",
        "risk_refs"
      ],
      "properties": {
        "hard_risk_direct_block": {
          "const": true
        },
        "risk_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "organization_container_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_body_ref",
        "scene_container_ref",
        "group_8d_identity_ref",
        "personal_8d_permission_ref",
        "organization_dedicated_application_system"
      ],
      "properties": {
        "system_body_ref": {
          "type": "string",
          "minLength": 1
        },
        "scene_container_ref": {
          "type": "string",
          "minLength": 1
        },
        "group_8d_identity_ref": {
          "type": "string",
          "minLength": 1
        },
        "personal_8d_permission_ref": {
          "type": "string",
          "minLength": 1
        },
        "organization_dedicated_application_system": {
          "const": true
        }
      }
    },
    "xiaoj_translation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanized_compliance_translator",
        "may_offer_safe_alternatives",
        "may_replace_total_field_authority"
      ],
      "properties": {
        "humanized_compliance_translator": {
          "const": true
        },
        "may_offer_safe_alternatives": {
          "const": true
        },
        "may_replace_total_field_authority": {
          "const": false
        }
      }
    },
    "cloud_candidate_policy": {
      "const": "CANDIDATE_ONLY_NO_AUTHORITY"
    },
    "redteam_status": {
      "type": "string",
      "enum": [
        "PASS",
        "HOLD",
        "WARN",
        "BLOCK"
      ]
    },
    "human_review_required": {
      "const": true
    },
    "total_field_decision": {
      "type": "string",
      "enum": [
        "PASS",
        "HOLD",
        "WARN",
        "BLOCK"
      ]
    },
    "humanized_response": {
      "type": "string"
    },
    "safe_alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "state_field_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "refs",
        "status"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "refs",
        "status",
        "execution_allowed",
        "db_write",
        "deploy",
        "restart",
        "router_write"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "execution_allowed": {
          "const": false
        },
        "db_write": {
          "const": false
        },
        "deploy": {
          "const": false
        },
        "restart": {
          "const": false
        },
        "router_write": {
          "const": false
        }
      }
    },
    "generative_transport_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "refs",
        "status",
        "mode",
        "not"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "state_packet_ref_reconstruction_equivalent_state"
        },
        "not": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "file_copy",
              "cloud_sync",
              "plaintext_transport"
            ]
          },
          "minItems": 3,
          "uniqueItems": true
        }
      }
    },
    "risk_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "refs",
        "status",
        "no_secret",
        "no_member_plaintext",
        "no_resident_plaintext",
        "no_raw_image",
        "no_db_write",
        "no_deploy",
        "no_restart",
        "no_router_write"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "no_secret": {
          "const": true
        },
        "no_member_plaintext": {
          "const": true
        },
        "no_resident_plaintext": {
          "const": true
        },
        "no_raw_image": {
          "const": true
        },
        "no_db_write": {
          "const": true
        },
        "no_deploy": {
          "const": true
        },
        "no_restart": {
          "const": true
        },
        "no_router_write": {
          "const": true
        }
      }
    },
    "envelope_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "refs",
        "status",
        "final_authority",
        "human_review_required",
        "candidate_only"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "final_authority": {
          "const": "total_field_verifier"
        },
        "human_review_required": {
          "const": true
        },
        "candidate_only": {
          "const": true
        }
      }
    }
  }
}
