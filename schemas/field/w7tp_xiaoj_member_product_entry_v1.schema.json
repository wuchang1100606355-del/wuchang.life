{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "w7tp://schemas/field/xiaoj-member-product-entry/v1",
  "title": "W7TP XiaoJ Member Product Entry Candidate V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "state",
    "reason_code",
    "candidate_only",
    "runtime_effect",
    "execution_allowed",
    "requires_total_field_verify",
    "odoo_role",
    "member_consent_authority",
    "safety_and_landing_authority",
    "candidate_authority",
    "member_gate_ref",
    "member_context_ref",
    "member_context_sha256",
    "member_model_visible_context",
    "xiaoj_member_browser_binding",
    "entry_sha256"
  ],
  "properties": {
    "schema_version": {"const": "w7tp.xiaoj-member-product-entry.v1"},
    "state": {"const": "PASS_XIAOJ_MEMBER_PRODUCT_ENTRY_CANDIDATE"},
    "reason_code": {"const": "PASS_T019_MEMBER_PRODUCT_ENTRY"},
    "candidate_only": {"const": true},
    "runtime_effect": {"const": false},
    "execution_allowed": {"const": false},
    "requires_total_field_verify": {"const": true},
    "db_write": {"const": false},
    "deploy": {"const": false},
    "restart": {"const": false},
    "member_plaintext_read": {"const": false},
    "secret_read": {"const": false},
    "odoo_role": {"const": "PROCESS_AND_MASKED_PROJECTION_NOT_SOVEREIGN_ROOT"},
    "member_consent_authority": {"const": "member"},
    "safety_and_landing_authority": {"const": "total_field_verifier"},
    "candidate_authority": {"const": "none"},
    "member_gate_ref": {"type": "string", "minLength": 1},
    "member_context_ref": {"type": "string", "minLength": 1},
    "member_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "member_model_visible_context": {"type": "object"},
    "xiaoj_member_browser_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_ref",
        "sovereign_member_ref",
        "device_ref",
        "safe_context_ref",
        "member_preference_ref",
        "service_style_ref",
        "behavior_info_ref",
        "cloud_compute_ref",
        "benefit_ref",
        "quota_ref",
        "odoo_identity_ref",
        "odoo_role_ref",
        "odoo_function_scope_ref",
        "odoo_permission_bucket_ref",
        "requires_total_field_verify",
        "submit_forbidden"
      ],
      "properties": {
        "member_ref": {"type": "string", "pattern": "^actor_ref:[A-Za-z0-9_./:-]+$"},
        "sovereign_member_ref": {"type": "string", "minLength": 1},
        "device_ref": {"type": "string", "minLength": 1},
        "safe_context_ref": {"type": "string", "minLength": 1},
        "member_preference_ref": {"type": "string", "minLength": 1},
        "service_style_ref": {"type": "string", "minLength": 1},
        "behavior_info_ref": {"type": "string"},
        "cloud_compute_ref": {"type": "string", "minLength": 1},
        "benefit_ref": {"type": "string", "minLength": 1},
        "quota_ref": {"type": "string", "minLength": 1},
        "odoo_identity_ref": {"type": "string", "minLength": 1},
        "odoo_role_ref": {"type": "string", "minLength": 1},
        "odoo_function_scope_ref": {"type": "string", "minLength": 1},
        "odoo_permission_bucket_ref": {"type": "string", "minLength": 1},
        "requires_total_field_verify": {"const": true},
        "submit_forbidden": {"const": true}
      }
    },
    "entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
