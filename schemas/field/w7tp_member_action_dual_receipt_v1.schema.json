    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "hash_algorithm",
        "hash_scope",
        "content_sha256"
      ],
      "properties": {
        "canonicalization": {
          "const": "UTF8_NFC_SORTED_KEYS_NO_WHITESPACE_NO_FLOATS"
        },
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "hash_scope": {
          "const": "ALL_PACKET_FIELDS_EXCEPT_INTEGRITY_CONTENT_SHA256"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
