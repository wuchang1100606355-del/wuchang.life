    "generative_transmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "state_packet_ref",
        "reconstruction_condition_ref",
        "equivalent_state_ref",
        "total_field_verify_ref",
        "ordinary_file_movement",
        "cloud_sync",
        "backup",
        "download_decryption"
      ],
      "properties": {
        "protocol": {
          "const": "W7TP_8D_INTENT_FIELD_PACKET"
        },
        "state_packet_ref": {
          "type": "string",
          "pattern": "^state_packet_ref:sha256:[0-9a-f]{64}$"
        },
        "reconstruction_condition_ref": {
          "type": "string",
          "pattern": "^reconstruction_condition_ref:sha256:[0-9a-f]{64}$"
        },
        "equivalent_state_ref": {
          "type": "string",
          "pattern": "^equivalent_state_ref:sha256:[0-9a-f]{64}$"
        },
        "total_field_verify_ref": {
          "type": "string",
          "pattern": "^total_field_verify_ref:sha256:[0-9a-f]{64}$"
