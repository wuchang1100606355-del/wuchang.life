{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:w7tp:schema:system-intent-root:v1",
  "title": "W7TP System Intent Root V1 Candidate",
  "description": "Closed D1 intent-root contract. It carries governed references and acceptance semantics, never raw input or formal effect authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "intent_root_id",
    "result",
    "subject",
    "scene",
    "known_state_refs",
    "constraints",
    "acceptance",
    "target_product_effect",
    "unresolved_effect",
    "human_confirmation_required",
    "authority",
    "raw_input_included",
    "member_plaintext_included",
    "secret_material_included"
  ],
  "properties": {
    "contract_version": {"const": "W7TP-SYSTEM-INTENT-ROOT/1.0"},
    "intent_root_id": {"$ref": "#/$defs/ref"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_ref", "outcome_code", "result_sha256"],
      "properties": {
        "result_ref": {"$ref": "#/$defs/ref"},
        "outcome_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_ref", "identity_mode", "identity_authority"],
      "properties": {
        "subject_ref": {"$ref": "#/$defs/ref"},
        "identity_mode": {"enum": ["ANONYMOUS_ROLE_REF", "ROLE_BINDING_REF", "8D_IDENTITY_PACKET_REF"]},
        "identity_authority": {"const": "ASSOCIATION_GOVERNED_MEMBER_IDENTITY_REGISTRY"}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_ref", "node_refs", "service_refs"],
      "properties": {
        "scene_ref": {"$ref": "#/$defs/ref"},
        "node_refs": {"$ref": "#/$defs/refs"},
        "service_refs": {"$ref": "#/$defs/refs"}
      }
    },
    "known_state_refs": {"$ref": "#/$defs/refs"},
    "constraints": {"$ref": "#/$defs/nonempty_refs"},
    "acceptance": {"$ref": "#/$defs/nonempty_refs"},
    "target_product_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_ref", "effect_class", "formal_effect_allowed"],
      "properties": {
        "effect_ref": {"$ref": "#/$defs/ref"},
        "effect_class": {"enum": ["INFORMATION_ONLY", "CANDIDATE_DRAFT", "NO_EFFECT"]},
        "formal_effect_allowed": {"const": false}
      }
    },
    "unresolved_effect": {"const": "HOLD_BEFORE_STATE_LOAD_OR_MODEL_CALL"},
    "human_confirmation_required": {"const": true},
    "authority": {"const": "CANDIDATE_ONLY"},
    "raw_input_included": {"const": false},
    "member_plaintext_included": {"const": false},
    "secret_material_included": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "pattern": "^(?:[a-z][a-z0-9_+.-]*):[A-Za-z0-9][A-Za-z0-9._:/#-]{0,255}$"},
    "refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "nonempty_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    }
  }
}
