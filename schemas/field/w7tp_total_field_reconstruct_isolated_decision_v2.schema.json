{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuchang.life/schemas/w7tp_total_field_reconstruct_isolated_decision_v2.schema.json",
  "title": "W7TP Total Field Reconstruct Isolated Decision V2",
  "type": "object",
  "required": [
    "contract", "decision_id", "decision", "state", "request_sha256", "scope_sha256",
    "target_field_snapshot_sha256", "target_base_state_sha256", "target_successor_canonical_sha256",
    "minimum_generative_delta_sha256", "exact_workspace", "exact_targets", "authorized_steps",
    "maximum_effect", "expires_at", "single_use", "review_request_single_use_consumed",
    "execution_single_use_consumed", "replay_disposition", "decision_hash_algorithm", "decision_sha256"
  ],
  "properties": {
    "contract": {"const": "W7TP-TOTAL-FIELD-RECONSTRUCT-ISOLATED-DECISION/2.0"},
    "decision_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["ALLOW", "DENY", "HOLD"]},
    "state": {"enum": ["PASS", "REJECT", "HOLD"]},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "scope_sha256": {"$ref": "#/$defs/sha256"},
    "target_field_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "target_base_state_sha256": {"$ref": "#/$defs/sha256"},
    "target_successor_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "minimum_generative_delta_sha256": {"$ref": "#/$defs/sha256"},
    "exact_workspace": {"type": "string", "pattern": "^runtime/isolated/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "exact_targets": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "authorized_steps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "maximum_effect": {"const": "ONE_ISOLATED_TARGET_NATIVE_RECONSTRUCTION_RUN"},
    "expires_at": {"type": "string", "format": "date-time"},
    "single_use": {"const": true},
    "review_request_single_use_consumed": {"const": true},
    "execution_single_use_consumed": {"const": false},
    "replay_disposition": {"const": "UNCONSUMED_FOR_EXECUTION"},
    "decision_hash_algorithm": {"const": "SHA256_CANONICAL_JSON_EXCLUDING_DECISION_SHA256/1.0"},
    "decision_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
