{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuchang.life/schemas/w7tp_total_field_worktree_index_review_request_v1.schema.json",
  "title": "W7TP Total Field Worktree Index Review Request V1",
  "type": "object",
  "required": [
    "schema_version", "packet_type", "state", "run_id", "authorization_request_id",
    "acceptance_mode", "float_data_index", "repository", "queue_binding",
    "index_manifest", "authority_binding", "logical_time", "single_use",
    "non_execution_assertions", "request_self_hash_algorithm", "request_self_sha256",
    "envelope_self_hash_algorithm", "envelope_self_sha256"
  ],
  "properties": {
    "schema_version": {"const": "W7TP-TOTAL-FIELD-WORKTREE-INDEX-REVIEW-REQUEST/1.0"},
    "packet_type": {"const": "TOTAL_FIELD_WORKTREE_INDEX_REVIEW_REQUEST_CANDIDATE"},
    "state": {"const": "CANDIDATE_PENDING_OWNER_SEAL_AND_FORMAL_SUBMISSION"},
    "run_id": {"$ref": "#/$defs/nonempty"},
    "authorization_request_id": {"$ref": "#/$defs/nonempty"},
    "acceptance_mode": {"const": "EXACT_STATE_ONLY"},
    "float_data_index": {"const": "NOT_APPLICABLE"},
    "repository": {
      "type": "object",
      "required": ["identity_reference", "identity_sha256", "path", "object_format", "branch", "base_head", "upstream_sha"],
      "properties": {
        "identity_reference": {"$ref": "#/$defs/repoPath"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "path": {"type": "string", "minLength": 1},
        "object_format": {"enum": ["sha1", "sha256"]},
        "branch": {"$ref": "#/$defs/nonempty"},
        "base_head": {"$ref": "#/$defs/gitOid"},
        "upstream_sha": {"$ref": "#/$defs/gitOid"}
      },
      "additionalProperties": false
    },
    "queue_binding": {
      "type": "object",
      "required": ["queue_path", "queue_entry_sha256", "candidate_content_sha256"],
      "properties": {
        "queue_path": {"$ref": "#/$defs/repoPath"},
        "queue_entry_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "index_manifest": {
      "type": "object",
      "required": ["schema_version", "staged_count", "entries", "excluded_files", "manifest_self_hash_algorithm", "manifest_self_sha256"],
      "properties": {
        "schema_version": {"const": "W7TP-GIT-INDEX-MANIFEST/1.0"},
        "staged_count": {"type": "integer", "minimum": 1},
        "entries": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "mode", "stage", "blob_oid", "staged_bytes_sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/repoPath"},
              "mode": {"pattern": "^[0-7]{6}$", "type": "string"},
              "stage": {"const": 0},
              "blob_oid": {"$ref": "#/$defs/gitOid"},
              "staged_bytes_sha256": {"$ref": "#/$defs/sha256"}
            },
            "additionalProperties": false
          }
        },
        "excluded_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
        "manifest_self_hash_algorithm": {"const": "SHA256_CANONICAL_JSON_EXCLUDING_MANIFEST_SELF_SHA256/1.0"},
        "manifest_self_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "authority_binding": {
      "type": "object",
      "required": ["canonical", "active_root", "founder_authorization", "d8_authority", "identity", "seat", "assignment", "access_profile"],
      "properties": {
        "canonical": {"$ref": "#/$defs/authorityRef"},
        "active_root": {"$ref": "#/$defs/authorityRef"},
        "founder_authorization": {"$ref": "#/$defs/authorityRef"},
        "d8_authority": {"$ref": "#/$defs/authorityRef"},
        "identity": {"$ref": "#/$defs/authorityRef"},
        "seat": {"$ref": "#/$defs/authorityRef"},
        "assignment": {"$ref": "#/$defs/authorityRef"},
        "access_profile": {"$ref": "#/$defs/authorityRef"}
      },
      "additionalProperties": false
    },
    "logical_time": {
      "type": "object",
      "required": ["namespace", "reference", "reference_sha256"],
      "properties": {
        "namespace": {"$ref": "#/$defs/nonempty"},
        "reference": {"$ref": "#/$defs/repoPath"},
        "reference_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "single_use": {
      "type": "object",
      "required": ["enabled", "nonce_reference", "nonce_sha256", "expires_at", "replay_protection"],
      "properties": {
        "enabled": {"const": true},
        "nonce_reference": {"$ref": "#/$defs/repoPath"},
        "nonce_sha256": {"$ref": "#/$defs/sha256"},
        "expires_at": {"type": "string", "format": "date-time"},
        "replay_protection": {"const": "REJECT_EXISTING_NONCE_OR_EXACT_BINDING"}
      },
      "additionalProperties": false
    },
    "non_execution_assertions": {
      "type": "object",
      "required": ["formal_submission", "reviewer_call", "receipt_creation", "owner_seal_activation", "git_write", "deploy", "restart", "db_write", "pointer_write", "canonical_write"],
      "properties": {
        "formal_submission": {"const": false}, "reviewer_call": {"const": false},
        "receipt_creation": {"const": false}, "owner_seal_activation": {"const": false},
        "git_write": {"const": false}, "deploy": {"const": false}, "restart": {"const": false},
        "db_write": {"const": false}, "pointer_write": {"const": false}, "canonical_write": {"const": false}
      },
      "additionalProperties": false
    },
    "request_self_hash_algorithm": {"const": "SHA256_CANONICAL_JSON_EXCLUDING_REQUEST_SELF_SHA256/1.0"},
    "request_self_sha256": {"$ref": "#/$defs/sha256"},
    "envelope_self_hash_algorithm": {"const": "SHA256_CANONICAL_JSON_EXCLUDING_BOTH_SELF_HASHES/1.0"},
    "envelope_self_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "repoPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "authorityRef": {
      "type": "object",
      "required": ["reference", "sha256"],
      "properties": {"reference": {"$ref": "#/$defs/repoPath"}, "sha256": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
