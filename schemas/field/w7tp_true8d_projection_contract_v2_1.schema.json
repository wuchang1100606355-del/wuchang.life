{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:w7tp:schema:true8d-projection-contract:v2.1",
  "$comment": "Append-only successor of w7tp_true8d_projection_contract_v2.schema.json. The V2 parent remains the explicit legacy input contract.",
  "title": "W7TP TRUE8D Non-Live Projection Contract V2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["common_input", "output"],
  "properties": {
    "common_input": {"$ref": "#/$defs/common_input"},
    "output": {"oneOf": [
      {"$ref": "#/$defs/d1"}, {"$ref": "#/$defs/d2"},
      {"$ref": "#/$defs/d3"}, {"$ref": "#/$defs/d4"},
      {"$ref": "#/$defs/d5"}, {"$ref": "#/$defs/d6"},
      {"$ref": "#/$defs/d7"}, {"$ref": "#/$defs/d8"}
    ]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "minLength": 1},
    "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "common_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "field_id", "event_id", "attempt_id", "logical_time", "snapshot_id", "previous_total_state_hash", "event_payload_hash", "adi_coordinate_ref", "canonical_schema_ref", "ruleset_hash", "rule_refs", "deadline_monotonic_ns"],
      "properties": {
        "contract_version": {"const": "W7TP-TRUE8D-MACHINE-CONTRACT/2.1"},
        "field_id": {"enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8"]},
        "event_id": {"$ref": "#/$defs/ref"},
        "attempt_id": {"$ref": "#/$defs/ref"},
        "logical_time": {"type": "integer"},
        "snapshot_id": {"$ref": "#/$defs/ref"},
        "previous_total_state_hash": {"$ref": "#/$defs/sha256"},
        "event_payload_hash": {"$ref": "#/$defs/sha256"},
        "adi_coordinate_ref": {"$ref": "#/$defs/ref"},
        "canonical_schema_ref": {"const": "schemas/w7tp_8d_multipurpose_packet_canonical_v2_1.schema.json"},
        "ruleset_hash": {"$ref": "#/$defs/sha256"},
        "rule_refs": {"$ref": "#/$defs/refs"},
        "deadline_monotonic_ns": {"type": "integer", "minimum": 0}
      }
    },
    "d1": {
      "type": "object", "additionalProperties": false,
      "required": ["normalized_intent_ref", "requested_effect_ref", "constraint_set_hash", "founder_authority_match"],
      "properties": {"normalized_intent_ref": {"$ref": "#/$defs/ref"}, "requested_effect_ref": {"$ref": "#/$defs/ref"}, "constraint_set_hash": {"$ref": "#/$defs/sha256"}, "founder_authority_match": {"type": "boolean"}}
    },
    "d2": {
      "type": "object", "additionalProperties": false,
      "required": ["previous_state_hash", "proposed_state_hash", "lifecycle_state"],
      "properties": {"previous_state_hash": {"$ref": "#/$defs/sha256"}, "proposed_state_hash": {"$ref": "#/$defs/sha256"}, "lifecycle_state": {"$ref": "#/$defs/ref"}}
    },
    "d3": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "actor_role", "channel", "node_id", "lan_state", "wan_state", "vpn_state", "firewall_state", "dns_state", "hardware_channel", "transition_hash"],
      "properties": {"branch": {"$ref": "#/$defs/ref"}, "actor_role": {"$ref": "#/$defs/ref"}, "channel": {"$ref": "#/$defs/ref"}, "node_id": {"$ref": "#/$defs/ref"}, "lan_state": {"$ref": "#/$defs/ref"}, "wan_state": {"$ref": "#/$defs/ref"}, "vpn_state": {"$ref": "#/$defs/ref"}, "firewall_state": {"$ref": "#/$defs/ref"}, "dns_state": {"$ref": "#/$defs/ref"}, "hardware_channel": {"$ref": "#/$defs/ref"}, "transition_hash": {"$ref": "#/$defs/sha256"}}
    },
    "d4": {
      "type": "object", "additionalProperties": false,
      "required": ["verified_evidence_refs", "verified_evidence_hashes", "completeness", "verification_summary_hash"],
      "properties": {"verified_evidence_refs": {"$ref": "#/$defs/refs"}, "verified_evidence_hashes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}}, "completeness": {"$ref": "#/$defs/ref"}, "verification_summary_hash": {"$ref": "#/$defs/sha256"}}
    },
    "d5": {
      "type": "object", "additionalProperties": false,
      "required": ["action_code", "target_ref", "precondition_hash", "side_effect_class", "requires_explicit_gate", "commit_applied"],
      "properties": {"action_code": {"$ref": "#/$defs/ref"}, "target_ref": {"$ref": "#/$defs/ref"}, "precondition_hash": {"$ref": "#/$defs/sha256"}, "side_effect_class": {"const": "NONE"}, "requires_explicit_gate": {"const": true}, "commit_applied": {"const": false}}
    },
    "d6": {
      "type": "object", "additionalProperties": false,
      "required": ["transport_protocol_ref", "lookup_refs", "reconstruction_condition_refs", "verification_method_ref", "equivalent_state_digest", "model_required", "float_value_count", "full_file_copy_present"],
      "properties": {"transport_protocol_ref": {"const": "W7TP_PROTOCOL_NATIVE_8D_STATE_FIELD_PACKET_V2_1"}, "lookup_refs": {"$ref": "#/$defs/refs"}, "reconstruction_condition_refs": {"$ref": "#/$defs/refs"}, "verification_method_ref": {"$ref": "#/$defs/ref"}, "equivalent_state_digest": {"$ref": "#/$defs/sha256"}, "model_required": {"const": false}, "float_value_count": {"const": 0}, "full_file_copy_present": {"const": false}}
    },
    "d7": {
      "type": "object", "additionalProperties": false,
      "required": ["risk_codes", "risk_level", "disposition", "blocking_evidence_refs"],
      "properties": {"risk_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "risk_level": {"type": "string"}, "disposition": {"enum": ["PASS", "HOLD", "BLOCK", "QUARANTINE"]}, "blocking_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}
    },
    "d8": {
      "type": "object", "additionalProperties": false,
      "required": ["packet_id", "authority_ref", "version", "ttl_seconds", "nonce", "sha256", "verifier_ref", "seal_policy"],
      "properties": {"packet_id": {"$ref": "#/$defs/ref"}, "authority_ref": {"const": "TOTAL_FIELD_CORE_UNDER_FOUNDER_AUTHORITY"}, "version": {"const": "2.1"}, "ttl_seconds": {"type": "integer", "minimum": 1}, "nonce": {"$ref": "#/$defs/ref"}, "sha256": {"$ref": "#/$defs/sha256"}, "verifier_ref": {"$ref": "#/$defs/ref"}, "seal_policy": {"const": "NO_COMMIT_NO_SEAL_READ_ONLY_SHADOW"}}
    }
  }
}
