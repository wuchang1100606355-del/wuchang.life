{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuchang.life/schemas/w7tp_total_field_successor_rebind_receipt_v1.schema.json",
  "title": "W7TP Total Field Successor Rebind Receipt V1",
  "type": "object",
  "required": [
    "schema_version",
    "packet_type",
    "receipt_id",
    "decision_id",
    "request_id",
    "run_id",
    "received_at",
    "request_expires_at",
    "nonce",
    "replay_guard",
    "request_sha256",
    "manifest_sha256",
    "decision_sha256",
    "authority_pointer_ref",
    "authority_pointer_sha256",
    "final_decision",
    "checks",
    "formal",
    "core_landing",
    "receipt_self_hash_algorithm",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "W7TP-TOTAL-FIELD-SUCCESSOR-REBIND-RECEIPT/1.0"},
    "packet_type": {"const": "TOTAL_FIELD_SUCCESSOR_REBIND_REVIEW_RECEIPT"},
    "receipt_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "received_at": {"type": "string", "format": "date-time"},
    "request_expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "pattern": "^nonce:sha256:[0-9a-f]{64}$"},
    "replay_guard": {
      "type": "object",
      "required": ["single_use", "domain", "disposition"],
      "properties": {
        "single_use": {"const": true},
        "domain": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["CONSUMED", "REPLAY_HOLD", "NOT_CONSUMED"]}
      },
      "additionalProperties": false
    },
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_pointer_ref": {"type": "string", "minLength": 1},
    "authority_pointer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "final_decision": {"enum": ["SUCCESSOR_REBIND_APPROVED", "SUCCESSOR_REBIND_REJECTED", "HOLD_SUCCESSOR_REBIND_REVIEW"]},
    "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["PASS", "HOLD", "REJECT", "NOT_REACHED"]}},
    "formal": {"type": "boolean"},
    "core_landing": {"const": "HOLD_PENDING_SEPARATE_AUTHORIZATION"},
    "receipt_self_hash_algorithm": {"const": "SHA256_CANONICAL_JSON_EXCLUDING_RECEIPT_SHA256/1.0"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
