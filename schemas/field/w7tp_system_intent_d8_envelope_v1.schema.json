{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:w7tp:schema:system-intent-d8-envelope:v1",
  "title": "W7TP System Intent D8 Envelope V1 Candidate",
  "description": "Closed reference-only D8 envelope for D1-D7 state roots, reconstruction instructions and candidate receipt chains.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "envelope_id",
    "state",
    "intent_root_ref",
    "current_state_root_ref",
    "minimum_delta_ref",
    "field_refs",
    "reconstruction_condition_refs",
    "verification_instruction_refs",
    "receipt_chain_ref",
    "authority",
    "human_confirmation_required",
    "created_at_utc",
    "expires_at_utc",
    "nonce",
    "envelope_sha256",
    "verifier_ref",
    "raw_input_included",
    "full_context_included",
    "member_plaintext_included",
    "secret_material_included",
    "formal_landing_allowed",
    "applies_change",
    "memory_effect",
    "database_write",
    "deployment",
    "restart",
    "remote_write"
  ],
  "properties": {
    "contract_version": {"const": "W7TP-SYSTEM-INTENT-D8-ENVELOPE/1.0"},
    "envelope_id": {"$ref": "#/$defs/ref"},
    "state": {"enum": ["HOLD", "BUILD_NOT_REQUIRED", "CANDIDATE_READY_FOR_TOTAL_FIELD"]},
    "intent_root_ref": {"$ref": "#/$defs/ref"},
    "current_state_root_ref": {"$ref": "#/$defs/ref"},
    "minimum_delta_ref": {"$ref": "#/$defs/nullable_ref"},
    "field_refs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"$ref": "#/$defs/d1_ref"},
        {"$ref": "#/$defs/d2_ref"},
        {"$ref": "#/$defs/d3_ref"},
        {"$ref": "#/$defs/d4_ref"},
        {"$ref": "#/$defs/d5_ref"},
        {"$ref": "#/$defs/d6_ref"},
        {"$ref": "#/$defs/d7_ref"}
      ],
      "items": false
    },
    "reconstruction_condition_refs": {"$ref": "#/$defs/nonempty_refs"},
    "verification_instruction_refs": {"$ref": "#/$defs/nonempty_refs"},
    "receipt_chain_ref": {"$ref": "#/$defs/ref"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_authority", "total_field_authority_state", "envelope_authority", "model_has_authority", "adapter_has_authority", "device_has_authority", "formal_effect_authorized"],
      "properties": {
        "decision_authority": {"const": "TOTAL_FIELD"},
        "total_field_authority_state": {"const": "INACTIVE"},
        "envelope_authority": {"const": "CANDIDATE_ONLY"},
        "model_has_authority": {"const": false},
        "adapter_has_authority": {"const": false},
        "device_has_authority": {"const": false},
        "formal_effect_authorized": {"const": false}
      }
    },
    "human_confirmation_required": {"const": true},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "nonce": {"$ref": "#/$defs/ref"},
    "envelope_sha256": {"$ref": "#/$defs/sha256"},
    "verifier_ref": {"$ref": "#/$defs/ref"},
    "raw_input_included": {"const": false},
    "full_context_included": {"const": false},
    "member_plaintext_included": {"const": false},
    "secret_material_included": {"const": false},
    "formal_landing_allowed": {"const": false},
    "applies_change": {"const": false},
    "memory_effect": {"const": false},
    "database_write": {"const": false},
    "deployment": {"const": false},
    "restart": {"const": false},
    "remote_write": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "pattern": "^(?:[a-z][a-z0-9_+.-]*):[A-Za-z0-9][A-Za-z0-9._:/#-]{0,255}$"},
    "nullable_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "nonempty_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "field_ref_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "state_ref", "state_sha256"],
      "properties": {
        "dimension": {"enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7"]},
        "state_ref": {"$ref": "#/$defs/ref"},
        "state_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "d1_ref": {"allOf": [{"$ref": "#/$defs/field_ref_base"}, {"properties": {"dimension": {"const": "D1"}}}]},
    "d2_ref": {"allOf": [{"$ref": "#/$defs/field_ref_base"}, {"properties": {"dimension": {"const": "D2"}}}]},
    "d3_ref": {"allOf": [{"$ref": "#/$defs/field_ref_base"}, {"properties": {"dimension": {"const": "D3"}}}]},
    "d4_ref": {"allOf": [{"$ref": "#/$defs/field_ref_base"}, {"properties": {"dimension": {"const": "D4"}}}]},
    "d5_ref": {"allOf": [{"$ref": "#/$defs/field_ref_base"}, {"properties": {"dimension": {"const": "D5"}}}]},
    "d6_ref": {"allOf": [{"$ref": "#/$defs/field_ref_base"}, {"properties": {"dimension": {"const": "D6"}}}]},
    "d7_ref": {"allOf": [{"$ref": "#/$defs/field_ref_base"}, {"properties": {"dimension": {"const": "D7"}}}]}
  }
}
