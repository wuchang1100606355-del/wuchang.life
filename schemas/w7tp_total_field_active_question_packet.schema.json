{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wuchang.life/schemas/w7tp_total_field_active_question_packet.schema.json",
  "title": "W7TP Total Field Deterministic Active Question Packet",
  "type": "object",
  "required": ["packet_id", "run_id", "schema_version", "rule_version", "state", "question_type", "trigger_rule_id", "trigger_refs", "question_code", "required_response_fields", "evidence_refs", "execution_authority", "verification_required", "seal_status", "d1_intent", "d2_state", "d3_coordinate", "d4_evidence", "d5_execution", "d6_generative_transmission", "d7_risk", "d8_envelope", "sha256"],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^QUESTION-[A-F0-9]{24}$"},
    "run_id": {"type": "string", "minLength": 8},
    "schema_version": {"const": "W7TP-TOTAL-FIELD-ACTIVE-QUESTION/1.0"},
    "rule_version": {"const": "W7TP-NON-FLOATING-RULES/1.0"},
    "state": {"const": "HOLD"},
    "question_type": {"enum": ["MISSING_STATE_QUESTION_PACKET", "EVIDENCE_CONFLICT_QUESTION_PACKET", "AUTHORITY_CLARIFICATION_PACKET", "RECONSTRUCTION_GAP_PACKET", "UNRESOLVED_ROUTE_PACKET", "NEW_RULE_CANDIDATE_PACKET"]},
    "trigger_rule_id": {"type": "string", "pattern": "^ACTIVE_QUESTION_RULE_[0-9]{2}$"},
    "trigger_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "question_code": {"enum": ["PROVIDE_REQUIRED_STATE_REFS", "RESOLVE_EVIDENCE_CONFLICT_REFS", "CLARIFY_AUTHORITY_REFS", "PROVIDE_RECONSTRUCTION_CONDITIONS", "RESOLVE_ROUTE_REFS", "REVIEW_NEW_RULE_CANDIDATE"]},
    "required_response_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "execution_authority": {"const": false},
    "verification_required": {"const": true},
    "seal_status": {"const": "NOT_SEALED"},
    "d1_intent": {"type": "object", "required": ["required_result"], "properties": {"required_result": {"const": "RESOLVE_EXPLICIT_TOTAL_FIELD_GAP"}}, "additionalProperties": false},
    "d2_state": {"type": "object", "required": ["question_state", "trigger_refs"], "properties": {"question_state": {"const": "HOLD"}, "trigger_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
    "d3_coordinate": {"type": "object", "required": ["node_ref", "engine_ref", "rule_ref"], "properties": {"node_ref": {"const": "TOTAL_FIELD"}, "engine_ref": {"const": "NON_FLOATING_DETERMINISTIC_AI"}, "rule_ref": {"type": "string"}}, "additionalProperties": false},
    "d4_evidence": {"type": "object", "required": ["evidence_refs"], "properties": {"evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "d5_execution": {"type": "object", "required": ["action"], "properties": {"action": {"const": "HOLD_FOR_STRUCTURED_RESPONSE"}}, "additionalProperties": false},
    "d6_generative_transmission": {"type": "object", "required": ["lookup_ref", "reconstruction_conditions", "verification_method", "packet_protocol"], "properties": {"lookup_ref": {"const": "lookup:total-field.active-question.v1"}, "reconstruction_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "verification_method": {"const": "EXPLICIT_GAP_REF_RESOLUTION"}, "packet_protocol": {"const": "W7TP-8D-PACKET-NATIVE/1.0"}}, "additionalProperties": false},
    "d7_risk": {"type": "object", "required": ["hard_risk", "authority_boundary_ok"], "properties": {"hard_risk": {"const": "MISSING_OR_CONFLICTING_REQUIRED_STATE"}, "authority_boundary_ok": {"const": true}}, "additionalProperties": false},
    "d8_envelope": {
      "type": "object",
      "required": ["authority_scope", "ttl_seconds", "nonce", "protocol", "verifier_ref"],
      "properties": {
        "authority_scope": {"const": ["TOTAL_FIELD_GOVERNANCE"]},
        "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "nonce": {"type": "string", "minLength": 8},
        "protocol": {"const": "W7TP-8D-PACKET-NATIVE/1.0"},
        "verifier_ref": {"const": "verifier:total-field.non-floating-ai"}
      },
      "additionalProperties": false
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
