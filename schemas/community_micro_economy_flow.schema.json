{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taiji Community Micro Economy Flow",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "node_scope",
    "economy_unit",
    "amount",
    "accounting_state",
    "human_review_required",
    "audit_required",
    "physical_delete_allowed"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "resident_purchase",
        "service_team_task",
        "happiness_coin_issue",
        "merchant_ticket_credit_issue",
        "fund_pool_retention",
        "local_redemption",
        "coin_burn",
        "wrong_entry_correction",
        "accounting_review"
      ]
    },
    "node_scope": {
      "type": "string",
      "enum": [
        "association",
        "renyi_store",
        "reopen_store",
        "group_member_merchant",
        "property_management_cloud",
        "business_cooperation_cloud",
        "community_service_team"
      ]
    },
    "economy_unit": {
      "type": "string",
      "enum": [
        "twd",
        "happiness_coin",
        "merchant_ticket_credit",
        "service_hour",
        "audit_metric"
      ]
    },
    "amount": {
      "type": "number"
    },
    "accounting_state": {
      "type": "string",
      "enum": [
        "draft",
        "pending_accounting_review",
        "approved",
        "reversed",
        "void_retained",
        "wrong_entry_corrected"
      ]
    },
    "correction_of_event_id": {
      "type": "string"
    },
    "human_review_required": {
      "type": "boolean"
    },
    "audit_required": {
      "type": "boolean",
      "const": true
    },
    "physical_delete_allowed": {
      "type": "boolean",
      "const": false
    },
    "member_plaintext_included": {
      "type": "boolean",
      "const": false
    },
    "cloud_plaintext_sync_allowed": {
      "type": "boolean",
      "const": false
    }
  },
  "additionalProperties": false
}
