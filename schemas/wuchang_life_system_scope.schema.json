{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taiji.wuchang_life_system_scope.v1",
  "title": "Wuchang Life System Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "domain",
    "scope_principle",
    "default_write_permission",
    "nodes",
    "domain_routes",
    "security_invariants"
  ],
  "properties": {
    "schema": { "type": "string", "const": "taiji.wuchang_life_system_scope.v1" },
    "status": { "type": "string", "enum": ["ACTIVE", "DRAFT", "PAUSED"] },
    "domain": { "type": "string", "const": "wuchang.life" },
    "source": { "type": "string" },
    "scope_principle": { "type": "string" },
    "default_write_permission": { "type": "string", "const": "blocked_until_gateway_authorized" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "machine",
          "tailscale_ip",
          "platform",
          "node_class",
          "scope_role",
          "last_seen_state",
          "write_permission"
        ],
        "properties": {
          "machine": { "type": "string", "minLength": 1 },
          "tailscale_ip": {
            "type": "string",
            "pattern": "^100\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
          },
          "platform": { "type": "string" },
          "node_class": {
            "type": "string",
            "enum": ["governance_host", "developer_workstation", "member_device", "mobile_device", "cloud_ephemeral_node", "linux_node", "windows_node"]
          },
          "scope_role": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "last_seen_state": { "type": "string", "enum": ["connected", "unknown"] },
          "write_permission": { "type": "string", "const": "blocked_until_gateway_authorized" },
          "notes": { "type": "string" }
        }
      }
    },
    "domain_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "purpose", "exposure"],
        "properties": {
          "host": { "type": "string" },
          "purpose": { "type": "string" },
          "exposure": { "type": "string", "enum": ["vpn_only", "public_summary_only", "manual_dns_only", "not_enabled"] }
        }
      }
    },
    "security_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_object_not_remote_control",
        "secret_material_allowed",
        "member_plaintext_cloud_allowed",
        "direct_production_write_allowed",
        "gateway_required",
        "audit_required"
      ],
      "properties": {
        "service_object_not_remote_control": { "type": "boolean", "const": true },
        "secret_material_allowed": { "type": "boolean", "const": false },
        "member_plaintext_cloud_allowed": { "type": "boolean", "const": false },
        "direct_production_write_allowed": { "type": "boolean", "const": false },
        "gateway_required": { "type": "boolean", "const": true },
        "audit_required": { "type": "boolean", "const": true }
      }
    }
  }
}
