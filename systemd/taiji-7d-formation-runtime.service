[Unit]
Description=Taiji 7D Formation Mesh Runtime 8127
After=network.target taiji-7d-formal-runtime.service
Wants=taiji-7d-formal-runtime.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/taiji_admin/Taiji_Hub/runtime/7d_formation_runtime_8127.py
WorkingDirectory=/home/taiji_admin/Taiji_Hub
User=taiji_admin
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
