[Unit]
Description=LittleJ Cognitive Router
After=network.target

[Service]
Type=simple
User=taiji_admin
WorkingDirectory=/home/taiji_admin/Taiji_Hub
ExecStart=/usr/bin/python3 /home/taiji_admin/Taiji_Hub/runtime/core/cognitive_router.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
