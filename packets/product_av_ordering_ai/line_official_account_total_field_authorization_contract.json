    "channel_secret_ref": "CHANNEL_SECRET_REF_VAULT_ONLY",
    "channel_access_token_runtime_ref": "CHANNEL_ACCESS_TOKEN_RUNTIME_REF_VAULT_ONLY",
    "message_policy_ref": "MESSAGE_POLICY_REF",
    "audience_policy_ref": "AUDIENCE_POLICY_REF",
    "consent_policy_ref": "CONSENT_POLICY_REF",
    "human_owner_admin_release_ref": "HUMAN_OWNER_ADMIN_RELEASE_REF"
  },
  "natural_language_intent_packet": {
    "tool": "tools/xiaoj_line_official_account_config_candidate.py",
