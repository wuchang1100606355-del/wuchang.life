[Unit]
Description=Taiji Hub system-level 8D ADI adaptive network observer
After=network.target w7tp-native-adi.service

[Service]
Type=simple
WorkingDirectory=/home/taiji_admin/Taiji_Hub
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /home/taiji_admin/Taiji_Hub/capabilities/w7tp-8d-adi-adaptive-network/scripts/network_runtime.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
