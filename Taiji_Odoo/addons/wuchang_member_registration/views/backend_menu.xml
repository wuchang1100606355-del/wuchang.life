    <record id="action_wuchang_member_ai_portal_dashboard" model="ir.actions.act_url">
        <field name="name">會員 AI 門戶儀表板</field>
        <field name="url">/my/wuchang_ai</field>
        <field name="target">self</field>
    </record>

    <!-- Top Menu -->
    <menuitem id="menu_wuchang_member_ai_portal_root"
              name="五常智慧雲門戶"
