              web_icon="wuchang_member_ai_portal,static/description/icon.png"
              groups="wuchang_member_ai_portal.group_wuchang_member_ai_portal_user"/>

    <!-- Action Menu -->
    <menuitem id="menu_wuchang_member_ai_portal_dashboard"
              name="會員 AI 門戶"
              parent="menu_wuchang_member_ai_portal_root"
              action="action_wuchang_member_ai_portal_dashboard"
              sequence="10"/>
</odoo>