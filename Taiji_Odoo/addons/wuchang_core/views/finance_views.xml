<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- Community Fund Account Views -->
    <record id="view_community_fund_account_tree" model="ir.ui.view">
        <field name="name">community.fund.account.tree</field>
        <field name="model">community.fund.account</field>
        <field name="arch" type="xml">
            <tree string="Community Fund Accounts">
                <field name="name"/>
                <field name="account_type"/>
                <field name="balance_twd"/>
                <field name="balance_whc"/>
                <field name="merchant_donation_total"/>
                <field name="consumer_donation_total"/>
                <field name="merchant_custody_total"/>
                <field name="deferred_whc_quota"/>
                <field name="deferred_voucher_quota"/>
            </tree>
        </field>
    </record>

    <record id="view_community_fund_account_form" model="ir.ui.view">
        <field name="name">community.fund.account.form</field>
        <field name="model">community.fund.account</field>
        <field name="arch" type="xml">
            <form string="Community Fund Account">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="account_type"/>
                        </group>
                        <group>
                            <field name="balance_twd"/>
                            <field name="balance_whc"/>
                        </group>
                        <group string="金流結構">
                            <field name="merchant_donation_total"/>
                            <field name="consumer_donation_total"/>
                            <field name="merchant_custody_total"/>
                        </group>
                        <group string="遞延額度">
                            <field name="deferred_whc_quota"/>
                            <field name="deferred_voucher_quota"/>
                        </group>
                        <group string="支援準備金">
                            <field name="association_balance"/>
                            <field name="head_office_balance"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Transparency Log Views -->
    <record id="view_transparency_log_tree" model="ir.ui.view">
        <field name="name">transparency.log.tree</field>
        <field name="model">transparency.log</field>
        <field name="arch" type="xml">
            <tree string="Transparency Logs" create="false" edit="false">
                <field name="timestamp"/>
                <field name="name"/>
                <field name="flow_type"/>
                <field name="amount"/>
            </tree>
        </field>
    </record>

    <!-- Wuchang Coin Transaction Views -->
    <record id="view_wuchang_coin_transaction_tree" model="ir.ui.view">
        <field name="name">wuchang.coin.transaction.tree</field>
        <field name="model">wuchang.coin.transaction</field>
        <field name="arch" type="xml">
            <tree string="Coin Transactions" create="false" edit="false">
                <field name="timestamp"/>
                <field name="transaction_type"/>
                <field name="source_partner_id"/>
                <field name="dest_partner_id"/>
                <field name="amount"/>
                <field name="hash_signature"/>
            </tree>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_community_fund_account" model="ir.actions.act_window">
        <field name="name">Community Funds</field>
        <field name="res_model">community.fund.account</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_transparency_log" model="ir.actions.act_window">
        <field name="name">Transparency Logs</field>
        <field name="res_model">transparency.log</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="action_wuchang_coin_transaction" model="ir.actions.act_window">
        <field name="name">Coin Transactions</field>
        <field name="res_model">wuchang.coin.transaction</field>
        <field name="view_mode">tree</field>
    </record>

