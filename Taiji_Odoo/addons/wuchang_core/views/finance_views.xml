    <!-- Wish Tree Views -->
    <record id="view_wish_tree_fruit_kanban" model="ir.ui.view">
        <field name="name">wish.tree.fruit.kanban</field>
        <field name="model">wish.tree.fruit</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="fruit_size"/>
                <field name="current_month_amount"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img alt="Fruit" t-att-src="'/web/static/img/placeholder.png'"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div>Raised: <field name="current_month_amount"/></div>
                                <div><field name="fruit_size"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_wish_tree_fruit" model="ir.actions.act_window">
        <field name="name">Wish Tree Fruits</field>
        <field name="res_model">wish.tree.fruit</field>
        <field name="view_mode">kanban,form,tree</field>
    </record>

    <record id="view_wish_tree_card_form" model="ir.ui.view">
        <field name="name">wish.tree.card.form</field>
        <field name="model">wish.tree.card</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_manager_approve" string="GM Approve" type="object" invisible="state != 'manager_review'" groups="base.group_user"/>
                    <button name="action_chairman_approve" string="Chairman Approve" type="object" invisible="state != 'chairman_review'" groups="base.group_user"/>
                    <button name="action_board_ratify" string="Board Ratify" type="object" invisible="state != 'board_review'" groups="base.group_user"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="applicant_id"/>
                        <field name="fruit_id"/>
                        <field name="target_amount"/>
                        <field name="current_amount"/>
                        <field name="progress" widget="progressbar"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wish_tree_card" model="ir.actions.act_window">
        <field name="name">Wish Cards</field>
        <field name="res_model">wish.tree.card</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>

    <record id="view_res_partner_wuchang_form" model="ir.ui.view">
        <field name="name">res.partner.wuchang.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Wuchang Identity">
                    <group>
                        <group string="Identity">
                            <field name="is_wuchang_resident"/>
                            <field name="is_wuchang_merchant"/>
                        </group>
                        <group string="Assets">
                            <field name="whc_wallet_balance"/>
                            <field name="merchant_quota_balance"/>
                        </group>
                    </group>
                    <field name="whc_ledger_ids" string="WHC Ledger">
                        <tree create="false" edit="false" delete="false">
                            <field name="amount"/>
                            <field name="create_date"/>
                            <field name="expiry_date"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <menuitem id="menu_fund_pool" name="Fund Pool" parent="menu_finance" action="action_community_fund_account" sequence="10"/>
    <menuitem id="menu_transparency_log" name="Transparency Logs" parent="menu_finance" action="action_transparency_log" sequence="20"/>
    <menuitem id="menu_coin_transaction" name="Coin Transactions" parent="menu_finance" action="action_wuchang_coin_transaction" sequence="30"/>

    <menuitem id="menu_wish_fruits" name="Org Fruits" parent="menu_wish_tree" action="action_wish_tree_fruit" sequence="10"/>
    <menuitem id="menu_wish_cards" name="Wish Cards" parent="menu_wish_tree" action="action_wish_tree_card" sequence="20"/>
    </data>
</odoo>