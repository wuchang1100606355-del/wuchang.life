<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_pos_expense_tree" model="ir.ui.view">
      <field name="name">wuchang.pos.expense.tree</field>
      <field name="model">wuchang.pos.expense</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="date"/>
          <field name="reason"/>
          <field name="amount" sum="總計"/>
          <field name="pos_config_id"/>
          <field name="company_id"/>
          <field name="table_name"/>
          <field name="user_id"/>
        </tree>
      </field>
    </record>

    <record id="view_pos_expense_form" model="ir.ui.view">
      <field name="name">wuchang.pos.expense.form</field>
      <field name="model">wuchang.pos.expense</field>
      <field name="arch" type="xml">
        <form string="POS 支出">
          <sheet>
            <group>
              <field name="name" readonly="1"/>
              <field name="date"/>
              <field name="reason"/>
              <field name="amount"/>
              <field name="pos_config_id"/>
              <field name="table_name"/>
              <field name="user_id" readonly="1"/>
              <field name="note"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_pos_expense_search" model="ir.ui.view">
      <field name="name">wuchang.pos.expense.search</field>
      <field name="model">wuchang.pos.expense</field>
      <field name="arch" type="xml">
        <search>
          <field name="reason"/>
          <field name="pos_config_id"/>
          <field name="company_id"/>
          <field name="user_id"/>
          <filter string="今日" name="today" domain="[('date','&gt;=', context_today())]"/>
          <group expand="0" string="群組依據">
            <filter string="商店" name="grp_store" context="{'group_by':'pos_config_id'}"/>
            <filter string="日期" name="grp_date" context="{'group_by':'date'}"/>
            <filter string="登記人" name="grp_user" context="{'group_by':'user_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="view_pos_expense_graph" model="ir.ui.view">
      <field name="name">wuchang.pos.expense.graph</field>
      <field name="model">wuchang.pos.expense</field>
      <field name="arch" type="xml">
        <graph string="POS 支出" type="bar">
          <field name="date" type="row"/>
          <field name="pos_config_id" type="col"/>
          <field name="amount" type="measure"/>
        </graph>
      </field>
    </record>

    <record id="action_pos_expense" model="ir.actions.act_window">
      <field name="name">POS 支出</field>
      <field name="res_model">wuchang.pos.expense</field>
      <field name="view_mode">tree,form,graph</field>
    </record>

    <record id="view_pos_config_wuchang_ext_form" model="ir.ui.view">
      <field name="name">pos.config.form.wuchang.wuchang_delivery_fund_partner</field>
      <field name="model">pos.config</field>
      <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//form" position="inside">
          <div class="col-12 col-lg-6 o_setting_box" id="wuchang_delivery_fund">
            <div class="o_setting_right_pane">
              <span class="o_form_label">五常外送基金規則</span>
              <div class="text-muted">
                設定外送基金合作夥伴
              </div>
              <div class="content-group">
                <field name="wuchang_delivery_fund_partner"/>
              </div>
            </div>
          </div>
        </xpath>
      </field>
    </record>

    <menuitem id="menu_wuchang_pos_root" name="POS 管理" parent="menu_wuchang_root" sequence="30"/>
    <menuitem id="menu_pos_expense" name="費用支出" parent="menu_wuchang_pos_root" action="action_pos_expense" sequence="10"/>
  </data>
</odoo>
