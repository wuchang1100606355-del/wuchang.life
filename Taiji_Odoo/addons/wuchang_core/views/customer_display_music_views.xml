<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 音樂播放清單樹狀視圖 -->
        <record id="view_customer_display_music_playlist_tree" model="ir.ui.view">
            <field name="name">wuchang.customer.display.music.playlist.tree</field>
            <field name="model">wuchang.customer.display.music.playlist</field>
            <field name="arch" type="xml">
                <tree string="音樂播放清單">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="artist"/>
                    <field name="genre"/>
                    <field name="source_type"/>
                    <field name="is_taiwan_cafe_appropriate" widget="boolean_toggle"/>
                    <field name="appropriateness_score"/>
                    <field name="is_active" widget="boolean_toggle"/>
                    <field name="play_count"/>
                </tree>
            </field>
        </record>

        <!-- 音樂播放清單表單視圖 -->
        <record id="view_customer_display_music_playlist_form" model="ir.ui.view">
            <field name="name">wuchang.customer.display.music.playlist.form</field>
            <field name="model">wuchang.customer.display.music.playlist</field>
            <field name="arch" type="xml">
                <form string="音樂播放清單">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="artist"/>
                                <field name="genre"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="source_type"/>
                                <field name="source_url" widget="url"/>
                                <field name="source_id"/>
                                <field name="duration_seconds"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="is_taiwan_cafe_appropriate" widget="boolean_toggle"/>
                                <field name="appropriateness_score"/>
                                <field name="is_active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="play_count" readonly="1"/>
                                <field name="last_played_date" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="備註">
                                <field name="note" placeholder="輸入備註..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- 音樂播放清單動作 -->
        <record id="action_customer_display_music_playlist" model="ir.actions.act_window">
            <field name="name">音樂播放清單</field>
            <field name="res_model">wuchang.customer.display.music.playlist</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- 設備音樂設定樹狀視圖 -->
        <record id="view_customer_display_music_config_tree" model="ir.ui.view">
            <field name="name">wuchang.customer.display.music.config.tree</field>
            <field name="model">wuchang.customer.display.music.config</field>
            <field name="arch" type="xml">
                <tree string="設備音樂設定">
                    <field name="device_id"/>
                    <field name="config_type"/>
                    <field name="priority"/>
                    <field name="is_active" widget="boolean_toggle"/>
                    <field name="set_by_user_id"/>
                    <field name="set_date"/>
                </tree>
            </field>
        </record>

        <!-- 設備音樂設定表單視圖 -->
        <record id="view_customer_display_music_config_form" model="ir.ui.view">
            <field name="name">wuchang.customer.display.music.config.form</field>
            <field name="model">wuchang.customer.display.music.config</field>
            <field name="arch" type="xml">
                <form string="設備音樂設定（人為設定優先）">
                    <header>
                        <button name="action_apply_config" type="object" string="套用設定" class="oe_highlight"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="device_id" placeholder="選擇客顯設備..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="config_type" widget="radio" options="{'horizontal': true}"/>
                                <field name="priority"/>
                                <field name="is_active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="set_by_user_id" readonly="1"/>
                                <field name="set_date" readonly="1"/>
                            </group>
                        </group>
                        
                        <!-- 手動指定播放清單 -->
                        <group string="手動指定播放清單（優先）" attrs="{'invisible': [('config_type', '!=', 'manual_playlist')]}">
                            <field name="manual_playlist_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        
                        <!-- 手動指定單曲 -->
                        <group string="手動指定單曲（優先）" attrs="{'invisible': [('config_type', '!=', 'manual_track')]}">
                            <field name="manual_track_name"/>
                            <field name="manual_artist"/>
                            <field name="manual_source_url" widget="url"/>
                        </group>
                        
                        <!-- 自動檢測設定 -->
                        <group string="自動檢測設定（僅在未手動設定時使用）" attrs="{'invisible': [('config_type', '!=', 'auto_detect')]}">
                            <field name="enable_auto_detect" widget="boolean_toggle"/>
                            <field name="auto_detect_interval" attrs="{'invisible': [('enable_auto_detect', '=', False)]}"/>
                        </group>
                        
                        <notebook>
                            <page string="備註">
                                <field name="note" placeholder="輸入設定說明..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- 設備音樂設定動作 -->
        <record id="action_customer_display_music_config" model="ir.actions.act_window">
            <field name="name">設備音樂設定</field>
            <field name="res_model">wuchang.customer.display.music.config</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_config_type': 'manual_playlist', 'default_priority': 10}</field>
        </record>

        <!-- 音樂檢查記錄樹狀視圖 -->
        <record id="view_customer_display_music_check_tree" model="ir.ui.view">
            <field name="name">wuchang.customer.display.music.check.tree</field>
            <field name="model">wuchang.customer.display.music.check</field>
            <field name="arch" type="xml">
                <tree string="音樂檢查記錄">
                    <field name="device_id"/>
                    <field name="check_date"/>
                    <field name="check_source"/>
                    <field name="current_track_name"/>
                    <field name="current_artist"/>
                    <field name="matches_manual_config" widget="boolean_toggle" decoration-success="matches_manual_config == True" decoration-danger="matches_manual_config == False"/>
                    <field name="manual_config_status" widget="badge" decoration-success="manual_config_status == 'matched'" decoration-danger="manual_config_status == 'not_matched'"/>
                    <field name="is_taiwan_cafe_appropriate" widget="boolean_toggle"/>
                    <field name="check_status"/>
                </tree>
            </field>
        </record>

        <!-- 音樂檢查記錄表單視圖 -->
        <record id="view_customer_display_music_check_form" model="ir.ui.view">
            <field name="name">wuchang.customer.display.music.check.form</field>
            <field name="model">wuchang.customer.display.music.check</field>
            <field name="arch" type="xml">
                <form string="音樂檢查記錄">
                    <sheet>
                        <group>
                            <group>
                                <field name="device_id"/>
                                <field name="check_date"/>
                                <field name="check_source"/>
                                <field name="check_status" widget="badge"/>
                            </group>
                            <group>
                                <field name="is_playing" widget="boolean_toggle"/>
                                <field name="current_track_name"/>
                                <field name="current_artist"/>
                                <field name="current_source"/>
                            </group>
                        </group>
                        <group string="人為設定比對結果（優先）">
                            <group>
                                <field name="config_id" readonly="1"/>
                                <field name="matches_manual_config" widget="boolean_toggle" decoration-success="matches_manual_config == True" decoration-danger="matches_manual_config == False"/>
                                <field name="manual_config_status" widget="badge" decoration-success="manual_config_status == 'matched'" decoration-danger="manual_config_status == 'not_matched'"/>
                            </group>
                            <group>
                                <field name="matched_playlist_id" readonly="1"/>
                                <field name="match_confidence"/>
                                <field name="is_taiwan_cafe_appropriate" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group>
                            <field name="volume_level"/>
                            <field name="audio_quality"/>
                        </group>
                        <notebook>
                            <page string="檢查訊息">
                                <field name="check_message"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- 音樂檢查記錄動作 -->
        <record id="action_customer_display_music_check" model="ir.actions.act_window">
            <field name="name">音樂檢查記錄</field>
            <field name="res_model">wuchang.customer.display.music.check</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- 選單項目 -->
        <menuitem id="menu_customer_display_music" name="客顯音樂管理" parent="menu_wuchang_infrastructure" sequence="30"/>
        <menuitem id="menu_customer_display_music_playlist" name="音樂播放清單" parent="menu_customer_display_music" action="action_customer_display_music_playlist" sequence="10"/>
        <menuitem id="menu_customer_display_music_config" name="設備音樂設定" parent="menu_customer_display_music" action="action_customer_display_music_config" sequence="20"/>
        <menuitem id="menu_customer_display_music_check" name="檢查記錄" parent="menu_customer_display_music" action="action_customer_display_music_check" sequence="30"/>

    </data>
</odoo>
