<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Inherit POS Config form to show business hours -->
    <record id="view_pos_config_form_wuchang_hours" model="ir.ui.view">
      <field name="name">pos.config.form.wuchang.hours</field>
      <field name="model">pos.config</field>
      <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//sheet" position="inside">
          <notebook>
            <page string="Business Hours">
              <group>
                <field name="opening_time"/>
                <field name="closing_time"/>
                <field name="overnight"/>
              </group>
            </page>
            <page string="Wuchang Modes">
              <group>
                <field name="wuchang_pos_mode"/>
                <field name="enable_digital_signage"/>
                <field name="signage_id" attrs="{'invisible': [('enable_digital_signage', '=', False)]}"/>
              </group>
            </page>
          </notebook>
        </xpath>
      </field>
    </record>

    <!-- Digital Signage Views -->
    <record id="view_wuchang_digital_signage_form" model="ir.ui.view">
        <field name="name">wuchang.digital.signage.form</field>
        <field name="model">wuchang.digital.signage</field>
        <field name="arch" type="xml">
            <form string="Digital Signage">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="device_ip"/>
                        <field name="status"/>
                        <field name="current_playlist_id"/>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="content_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="media_type"/>
                                    <field name="duration"/>
                                    <field name="url"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wuchang_digital_signage_tree" model="ir.ui.view">
        <field name="name">wuchang.digital.signage.tree</field>
        <field name="model">wuchang.digital.signage</field>
        <field name="arch" type="xml">
            <tree string="Digital Signage">
                <field name="name"/>
                <field name="device_ip"/>
                <field name="status"/>
                <field name="current_playlist_id"/>
            </tree>
        </field>
    </record>

    <record id="action_wuchang_digital_signage" model="ir.actions.act_window">
        <field name="name">Digital Signage</field>
        <field name="res_model">wuchang.digital.signage</field>
        <field name="view_mode">tree,form</field>
    </record>
  </data>
</odoo>
