<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_wuchang_order_tree" model="ir.ui.view">
    <field name="name">wuchang.order.tree</field>
    <field name="model">wuchang.order</field>
    <field name="arch" type="xml">
      <list string="線上訂單">
        <field name="name"/>
        <field name="state"/>
        <field name="customer_name"/>
        <field name="phone"/>
        <field name="sale_mode"/>
        <field name="service_relation_type"/>
        <field name="care_context"/>
        <field name="sovereign_ai_persona"/>
        <field name="eight_dimensional_code_ref"/>
        <field name="property_community_id"/>
        <field name="merchant_id"/>
        <field name="delivery_team_id"/>
        <field name="social_worker_governance_required"/>
        <field name="caregiver_employee_required"/>
        <field name="delivery_address"/>
        <field name="delivery_time"/>
        <field name="total_amount"/>
        <field name="create_date"/>
      </list>
    </field>
  </record>

  <record id="view_wuchang_order_form" model="ir.ui.view">
    <field name="name">wuchang.order.form</field>
    <field name="model">wuchang.order</field>
    <field name="arch" type="xml">
      <form string="線上訂單">
        <sheet>
          <group>
            <field name="name" readonly="1"/>
            <field name="state"/>
          </group>
          <group string="客戶資訊">
            <field name="customer_name"/>
            <field name="phone"/>
          </group>
          <group string="外送資訊">
            <field name="sale_mode"/>
            <field name="service_relation_type"/>
            <field name="care_context"/>
            <field name="property_community_id"/>
            <field name="property_unit_id"/>
            <field name="merchant_id"/>
            <field name="delivery_team_id"/>
            <field name="caregiver_staff_id"/>
            <field name="social_worker_partner_id"/>
            <field name="social_worker_governance_required"/>
            <field name="caregiver_employee_required"/>
            <field name="requires_caregiver_escort"/>
            <field name="requires_social_worker_review"/>
            <field name="total_field_relation_ref"/>
            <field name="sovereign_ai_persona"/>
            <field name="eight_dimensional_code_ref"/>
            <field name="property_commerce_relation_summary" readonly="1"/>
            <field name="delivery_address"/>
            <field name="delivery_time"/>
            <field name="delivery_note"/>
          </group>
          <group string="金額與品項">
            <field name="total_amount"/>
            <field name="items_json"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_wuchang_order" model="ir.actions.act_window">
    <field name="name">線上訂單</field>
    <field name="res_model">wuchang.order</field>
    <field name="view_mode">list,form</field>
    <field name="context">{"search_default_delivery": 1}</field>
  </record>

  <menuitem id="menu_wuchang_order" name="物業商業外送訂單" parent="wuchang_core.menu_wuchang_root" action="action_wuchang_order" sequence="35" groups="base.group_user"/>
</odoo>
