<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate='1'>
        <!-- Configure VM Agent for Local Operation -->
        <record id='config_vm_agent_mode' model='ir.config_parameter'>
            <field name='key'>wuchang.agent.mode</field>
            <field name='value'>local_vm</field>
        </record>
        <record id='config_vm_ip' model='ir.config_parameter'>
            <field name='key'>wuchang.workspace.vm_ip</field>
            <field name='value'>127.0.0.1</field>
        </record>
        <record id='config_agent_enabled' model='ir.config_parameter'>
            <field name='key'>wuchang.agent.enabled</field>
            <field name='value'>True</field>
        </record>
    </data>
</odoo>
