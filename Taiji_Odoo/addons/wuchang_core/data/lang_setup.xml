<odoo>
    <data noupdate="1">
        <!-- Activate Traditional Chinese Language -->
        <record id="base.lang_zh_TW" model="res.lang">
            <field name="active">True</field>
        </record>
        
        <!-- Set Traditional Chinese as Default for new users (optional, but requested context implies Chinese system) -->
        <function model="ir.default" name="set" eval="('res.partner', 'lang', 'zh_TW')"/>
    </data>
</odoo>
