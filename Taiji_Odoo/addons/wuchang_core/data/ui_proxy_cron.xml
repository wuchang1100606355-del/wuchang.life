<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- UI 代理服務心跳檢查定時任務 -->
        <record id="ir_cron_check_ui_status" model="ir.cron">
            <field name="name">檢查 UI 設備狀態</field>
            <field name="model_id" ref="model_wuchang_ui_proxy"/>
            <field name="state">code</field>
            <field name="code">model.check_ui_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="doall">False</field>
        </record>
    </data>
</odoo>
