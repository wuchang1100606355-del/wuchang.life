<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- AI Task Reminder Cron (Process) -->
        <record id="ir_cron_ai_task_reminder" model="ir.cron">
            <field name="name">AI Process Reminder (Task)</field>
            <field name="model_id" ref="model_wuchang_task"/>
            <field name="state">code</field>
            <field name="code">model.cron_ai_task_reminder()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>

        <!-- AI Memory Recall Cron (Memory) -->
        <record id="ir_cron_ai_memory_recall" model="ir.cron">
            <field name="name">AI Memory Recall (Work Log)</field>
            <field name="model_id" ref="model_wuchang_ai_memory"/>
            <field name="state">code</field>
            <field name="code">model.cron_ai_memory_recall()</field>
            <field name="interval_number">60</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
