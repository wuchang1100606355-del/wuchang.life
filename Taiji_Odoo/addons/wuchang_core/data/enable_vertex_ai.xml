<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate='1'>
        <!-- Enable Vertex AI Mode -->
        <record id='param_wuchang_ai_mode' model='ir.config_parameter'>
            <field name='key'>wuchang.ai.mode</field>
            <field name='value'>vertex_ai</field>
        </record>
        
        <!-- Default Project ID -->
        <record id='param_wuchang_google_project_id' model='ir.config_parameter'>
            <field name='key'>wuchang.google.project_id</field>
            <field name='value'>coffee-spark-ai-barista-b10b5</field>
        </record>
        
        <!-- Default Location (Updated to Taiwan) -->
        <record id='param_wuchang_google_location' model='ir.config_parameter'>
            <field name='key'>wuchang.google.location</field>
            <field name='value'>asia-east1</field>
        </record>
    </data>
</odoo>
