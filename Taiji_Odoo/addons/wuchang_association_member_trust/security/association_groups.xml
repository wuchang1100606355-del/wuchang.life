<odoo>
  <record id="module_category_wuchang_association_governance" model="ir.module.category">
    <field name="name">Wuchang Association Governance</field>
    <field name="description">Role boundaries for association-domain member consent, data rights, and merchant governance records.</field>
    <field name="sequence">85</field>
  </record>

  <record id="group_wuchang_association_manager" model="res.groups">
    <field name="name">Wuchang Association Manager</field>
    <field name="category_id" ref="module_category_wuchang_association_governance"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    <field name="comment">Managers may create, update, and delete association governance records; ordinary internal users remain read-only.</field>
  </record>
</odoo>
