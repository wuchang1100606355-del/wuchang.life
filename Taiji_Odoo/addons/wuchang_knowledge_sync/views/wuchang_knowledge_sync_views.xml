<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <menuitem id="menu_wuchang_knowledge_root" name="五常知識庫同步" sequence="98"/>

    <record id="view_wuchang_knowledge_source_list" model="ir.ui.view">
        <field name="name">wuchang.knowledge.source.list</field>
        <field name="model">wuchang.knowledge.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="root_path"/>
                <field name="host_path_note"/>
                <field name="source_type"/>
                <field name="sync_state"/>
                <field name="last_sync_at"/>
                <field name="item_count"/>
            </list>
        </field>
    </record>

    <record id="view_wuchang_knowledge_source_form" model="ir.ui.view">
        <field name="name">wuchang.knowledge.source.form</field>
        <field name="model">wuchang.knowledge.source</field>
        <field name="arch" type="xml">
            <form string="知識庫同步來源">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="root_path"/>
                        <field name="host_path_note"/>
                        <field name="source_type"/>
                        <field name="sync_state"/>
                        <field name="last_sync_at"/>
                        <field name="item_count"/>
                    </group>
                    <notebook>
                        <page string="安全政策"><field name="safety_policy"/></page>
                        <page string="備註"><field name="notes"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wuchang_knowledge_source" model="ir.actions.act_window">
        <field name="name">知識庫來源</field>
        <field name="res_model">wuchang.knowledge.source</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_wuchang_knowledge_source" name="知識庫來源" parent="menu_wuchang_knowledge_root" action="action_wuchang_knowledge_source" sequence="10"/>

    <record id="view_wuchang_knowledge_item_list" model="ir.ui.view">
        <field name="name">wuchang.knowledge.item.list</field>
        <field name="model">wuchang.knowledge.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source_id"/>
                <field name="relative_path"/>
                <field name="file_ext"/>
                <field name="size_bytes"/>
                <field name="sync_status"/>
                <field name="privacy_level"/>
                <field name="modified_at"/>
            </list>
        </field>
    </record>

    <record id="view_wuchang_knowledge_item_form" model="ir.ui.view">
        <field name="name">wuchang.knowledge.item.form</field>
        <field name="model">wuchang.knowledge.item</field>
        <field name="arch" type="xml">
            <form string="知識庫項目">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="source_id"/>
                        <field name="relative_path"/>
                        <field name="absolute_path"/>
                        <field name="file_ext"/>
                        <field name="size_bytes"/>
                        <field name="modified_at"/>
                        <field name="sha256"/>
                        <field name="sync_status"/>
                        <field name="privacy_level"/>
                        <field name="skipped_reason"/>
                    </group>
                    <notebook>
                        <page string="安全摘要"><field name="content_excerpt"/></page>
                        <page string="備註"><field name="notes"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wuchang_knowledge_item" model="ir.actions.act_window">
        <field name="name">知識庫項目</field>
        <field name="res_model">wuchang.knowledge.item</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_wuchang_knowledge_item" name="知識庫項目" parent="menu_wuchang_knowledge_root" action="action_wuchang_knowledge_item" sequence="20"/>
</odoo>
