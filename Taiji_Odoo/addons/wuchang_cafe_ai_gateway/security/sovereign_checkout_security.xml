<odoo>
  <record id="rule_wuchang_sovereign_voucher_checkout_staff_own" model="ir.rule">
    <field name="name">Sovereign voucher checkout: staff sees own requests</field>
    <field name="model_id" ref="model_wuchang_sovereign_voucher_checkout"/>
    <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('wuchang_member_registration.group_wuchang_member_staff'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <record id="rule_wuchang_sovereign_voucher_checkout_manager_all" model="ir.rule">
    <field name="name">Sovereign voucher checkout: manager audit scope</field>
    <field name="model_id" ref="model_wuchang_sovereign_voucher_checkout"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('wuchang_member_registration.group_wuchang_member_manager'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
</odoo>
