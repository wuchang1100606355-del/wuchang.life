<odoo>
    <record id="module_category_wuchang_cafe_operations" model="ir.module.category">
        <field name="name">上品聊國咖啡館店務</field>
        <field name="description">咖啡館店務、POS、自助點餐與 AI 店員的分域權限。</field>
        <field name="sequence">81</field>
    </record>

    <record id="group_wuchang_cafe_merchant_viewer" model="res.groups">
        <field name="name">商家檢視者</field>
        <field name="category_id" ref="module_category_wuchang_cafe_operations"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_portal')])]"/>
        <field name="comment">只進入自己的咖啡館網頁介面，不得登入 Odoo 後台或存取協會會員個資。</field>
    </record>

    <record id="group_wuchang_cafe_merchant_operator" model="res.groups">
        <field name="name">店務操作員</field>
        <field name="category_id" ref="module_category_wuchang_cafe_operations"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_wuchang_cafe_merchant_viewer')])]"/>
        <field name="comment">執行經商家帳號明確授權的店務操作，不取得全域 POS 管理權。</field>
    </record>

    <record id="group_wuchang_cafe_merchant_manager" model="res.groups">
        <field name="name">店務管理員</field>
        <field name="category_id" ref="module_category_wuchang_cafe_operations"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_wuchang_cafe_merchant_operator')])]"/>
        <field name="comment">管理授權店面的店務能力；協會會員個資權限永遠不隨此角色取得。</field>
    </record>

    <record id="rule_wuchang_cafe_merchant_account_self" model="ir.rule">
        <field name="name">商家只能讀取自己的店務帳號</field>
        <field name="model_id" ref="model_wuchang_cafe_merchant_account"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_wuchang_cafe_merchant_viewer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_wuchang_ai_compute_binding_self" model="ir.rule">
        <field name="name">入口使用者只能讀取自己的 LLM 算力狀態</field>
        <field name="model_id" ref="model_wuchang_ai_compute_binding"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
