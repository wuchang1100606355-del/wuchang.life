<odoo>
    <template id="portal_xiaoj_workspace" name="小J 8DADI 服務介面">
        <t t-call="portal.portal_layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-9">
                        <div class="mb-4">
                            <p class="text-muted mb-2">8DADI 商家 AI 握手</p>
                            <h1>小J服務介面</h1>
                            <p>用自然語言提出需求。系統只會呼叫你已綁定且有權使用的能力；Google 登入不會取得創辦人後台或創辦人算力。</p>
                        </div>
                        <form method="post" action="/my/xiaoj" class="card card-body shadow-sm mb-4">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <label class="form-label" for="xiaoj_intent">告訴小J你要完成什麼</label>
                            <textarea id="xiaoj_intent" name="intent" class="form-control mb-3" rows="4" required="required" placeholder="例如：小J，我要去聊國咖啡，先幫我看看有沒有位子，點一杯拿鐵，我 10 分鐘後到。"/>
                            <input type="hidden" name="store_ref" value="liaoguo_main_store"/>
                            <button type="submit" class="btn btn-primary align-self-start">與商家 AI 握手</button>
                        </form>
                        <div t-if="response" class="card card-body shadow-sm">
                            <h2 class="h4">握手結果</h2>
                            <p><strong>狀態：</strong><t t-esc="response.get('state')"/></p>
                            <p t-if="response.get('d2_state', {}).get('seat')"><strong>座位：</strong><t t-esc="response['d2_state']['seat'].get('state')"/></p>
                            <p t-if="response.get('d2_state', {}).get('menu')"><strong>菜單：</strong><t t-esc="response['d2_state']['menu'].get('state')"/></p>
                            <details>
                                <summary>8DADI 回執</summary>
                                <pre class="mt-3"><t t-esc="response_json"/></pre>
                            </details>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
