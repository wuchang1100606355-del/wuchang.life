<odoo>
    <record id="view_wuchang_cafe_ai_eventbook_list" model="ir.ui.view">
        <field name="name">wuchang.cafe.ai.eventbook.list</field>
        <field name="model">wuchang.cafe.ai.eventbook</field>
        <field name="arch" type="xml">
            <list string="AI Eventbook" create="false">
                <field name="create_date"/>
                <field name="name"/>
                <field name="event_type"/>
                <field name="source"/>
                <field name="intent"/>
                <field name="risk_level"/>
                <field name="result"/>
                <field name="confirmation_required"/>
            </list>
        </field>
    </record>

    <record id="view_wuchang_cafe_ai_eventbook_form" model="ir.ui.view">
        <field name="name">wuchang.cafe.ai.eventbook.form</field>
        <field name="model">wuchang.cafe.ai.eventbook</field>
        <field name="arch" type="xml">
            <form string="AI Eventbook">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="event_type"/>
                        <field name="source"/>
                        <field name="session_ref"/>
                        <field name="user_role"/>
                        <field name="intent"/>
                        <field name="tool_name"/>
                    </group>
                    <group>
                        <field name="risk_level"/>
                        <field name="confirmation_required"/>
                        <field name="confirmation_result"/>
                        <field name="target_model"/>
                        <field name="target_record_id"/>
                        <field name="result"/>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload_json"/>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wuchang_cafe_ai_eventbook" model="ir.actions.act_window">
        <field name="name">AI Eventbook</field>
        <field name="res_model">wuchang.cafe.ai.eventbook</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_wuchang_cafe_root"
              name="WuChang Cafe"
              sequence="80"/>

    <menuitem id="menu_wuchang_cafe_ai_eventbook"
              name="AI Eventbook"
              parent="menu_wuchang_cafe_root"
              action="action_wuchang_cafe_ai_eventbook"
              sequence="10"/>
</odoo>
