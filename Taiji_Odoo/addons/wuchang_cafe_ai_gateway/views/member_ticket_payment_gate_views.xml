<odoo>
    <record id="view_wuchang_member_ticket_payment_gate_list" model="ir.ui.view">
        <field name="name">wuchang.business.backend.member.ticket.payment.gate.list</field>
        <field name="model">wuchang.business.backend.member.ticket.payment.gate</field>
        <field name="arch" type="xml">
            <list string="Member Ticket Payment Gate">
                <field name="create_date"/>
                <field name="name"/>
                <field name="member_identity_ref"/>
                <field name="member_authority_state"/>
                <field name="ticket_state"/>
                <field name="entitlement_state"/>
                <field name="voucher_state"/>
                <field name="happiness_coin_state"/>
                <field name="product_menu_quality_state"/>
                <field name="consent_state"/>
                <field name="pre_payment_gate_state"/>
                <field name="final_gate_decision"/>
                <field name="packet_hash"/>
            </list>
        </field>
    </record>

    <record id="view_wuchang_member_ticket_payment_gate_form" model="ir.ui.view">
        <field name="name">wuchang.business.backend.member.ticket.payment.gate.form</field>
        <field name="model">wuchang.business.backend.member.ticket.payment.gate</field>
        <field name="arch" type="xml">
            <form string="Member Ticket Payment Gate">
                <header>
                    <button name="action_build_member_ticket_payment_gate"
                            type="object"
                            string="Build Member Ticket Payment Gate"
                            class="btn-primary"/>
                    <field name="pre_payment_gate_state" widget="statusbar" statusbar_visible="draft,ready_for_dryrun,hold,rejected,approved_dryrun_only"/>
                </header>
                <sheet>
                    <group string="Dry-run Boundary">
                        <field name="name"/>
                        <field name="final_gate_decision" readonly="1"/>
                        <field name="packet_hash" readonly="1"/>
                        <field name="payment_action_requested"/>
                    </group>
                    <group string="Member Authority">
                        <field name="member_identity_ref"/>
                        <field name="member_authority_state"/>
                        <field name="consent_ref"/>
                        <field name="consent_state"/>
                    </group>
                    <group string="Ticket And Benefits">
                        <field name="ticket_ref"/>
                        <field name="ticket_state"/>
                        <field name="entitlement_ref"/>
                        <field name="entitlement_state"/>
                        <field name="voucher_ref"/>
                        <field name="voucher_state"/>
                        <field name="happiness_coin_ref"/>
                        <field name="happiness_coin_state"/>
                    </group>
                    <group string="Cart And Product Evidence">
                        <field name="cart_ref"/>
                        <field name="product_menu_quality_ref"/>
                        <field name="product_menu_quality_state"/>
                        <field name="odoo_product_ref"/>
                        <field name="price_ref"/>
                        <field name="custom_options_ref"/>
                        <field name="photo_evidence_ref"/>
                        <field name="photo_evidence_state"/>
                        <field name="ai_candidate_state"/>
                    </group>
                    <group string="Blockers">
                        <field name="blocker_generated_image_only" readonly="1"/>
                        <field name="blocker_missing_member_authority" readonly="1"/>
                        <field name="blocker_missing_ticket_or_entitlement" readonly="1"/>
                        <field name="blocker_missing_price" readonly="1"/>
                        <field name="blocker_missing_custom_options" readonly="1"/>
                        <field name="blocker_missing_photo_evidence" readonly="1"/>
                        <field name="blocker_missing_consent" readonly="1"/>
                        <field name="blocker_product_menu_quality_not_pass" readonly="1"/>
                        <field name="blocker_payment_action_requested" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Packet">
                            <field name="packet_json" readonly="1"/>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Refs, states, hashes, and placeholders only."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wuchang_member_ticket_payment_gate_search" model="ir.ui.view">
        <field name="name">wuchang.business.backend.member.ticket.payment.gate.search</field>
        <field name="model">wuchang.business.backend.member.ticket.payment.gate</field>
        <field name="arch" type="xml">
            <search string="Member Ticket Payment Gate">
                <field name="name"/>
                <field name="member_identity_ref"/>
                <field name="ticket_ref"/>
                <field name="cart_ref"/>
                <field name="packet_hash"/>
                <filter name="allow_dryrun" string="ALLOW_DRYRUN" domain="[('final_gate_decision','=','ALLOW_DRYRUN')]"/>
                <filter name="hold" string="HOLD" domain="[('final_gate_decision','=','HOLD')]"/>
                <filter name="reject" string="REJECT" domain="[('final_gate_decision','=','REJECT')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_decision" string="Decision" context="{'group_by': 'final_gate_decision'}"/>
                    <filter name="group_gate_state" string="Gate State" context="{'group_by': 'pre_payment_gate_state'}"/>
                    <filter name="group_product_menu_quality" string="Product/Menu Quality" context="{'group_by': 'product_menu_quality_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wuchang_member_ticket_payment_gate" model="ir.actions.act_window">
        <field name="name">Build Member Ticket Payment Gate</field>
        <field name="res_model">wuchang.business.backend.member.ticket.payment.gate</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_pre_payment_gate_state': 'ready_for_dryrun'}</field>
    </record>

    <menuitem id="menu_wuchang_member_ticket_payment_gate"
              name="Member Ticket Payment Gate"
              parent="menu_wuchang_cafe_root"
              action="action_wuchang_member_ticket_payment_gate"
              sequence="95"/>
</odoo>
