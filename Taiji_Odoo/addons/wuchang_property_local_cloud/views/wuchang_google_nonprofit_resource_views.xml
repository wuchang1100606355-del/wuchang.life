<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wuchang_google_nonprofit_resource_list" model="ir.ui.view">
        <field name="name">wuchang.google.nonprofit.resource.list</field>
        <field name="model">wuchang.google.nonprofit.resource</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="holder_company_id"/>
                <field name="provider"/>
                <field name="resource_category"/>
                <field name="eligibility_state"/>
                <field name="resource_state"/>
                <field name="monthly_value_usd"/>
                <field name="annual_value_usd"/>
                <field name="storage_quota_note"/>
                <field name="compute_quota_note"/>
            </list>
        </field>
    </record>

    <record id="view_wuchang_google_nonprofit_resource_form" model="ir.ui.view">
        <field name="name">wuchang.google.nonprofit.resource.form</field>
        <field name="model">wuchang.google.nonprofit.resource</field>
        <field name="arch" type="xml">
            <form string="Google 非營利組織優惠與外部算力資源池">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="holder_company_id"/>
                        <field name="holder_partner_id"/>
                    </group>
                    <group string="資源">
                        <field name="provider"/>
                        <field name="resource_category"/>
                        <field name="eligibility_state"/>
                        <field name="resource_state"/>
                    </group>
                    <group string="額度">
                        <field name="monthly_value_usd"/>
                        <field name="annual_value_usd"/>
                        <field name="storage_quota_note"/>
                        <field name="compute_quota_note"/>
                    </group>
                    <notebook>
                        <page string="五常社區雲用途">
                            <field name="use_case"/>
                        </page>
                        <page string="隱私/資料邊界">
                            <field name="privacy_boundary"/>
                        </page>
                        <page string="主權邊界">
                            <field name="sovereignty_boundary"/>
                        </page>
                        <page string="備註">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wuchang_google_nonprofit_resource" model="ir.actions.act_window">
        <field name="name">Google 非營利資源池</field>
        <field name="res_model">wuchang.google.nonprofit.resource</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_wuchang_google_nonprofit_resource"
              name="Google 非營利資源池"
              parent="menu_wuchang_property_root"
              action="action_wuchang_google_nonprofit_resource"
              sequence="97"/>
</odoo>
