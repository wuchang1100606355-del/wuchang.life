<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_google_workspace" model="ir.ui.view">
        <field name="name">res.company.form.google.workspace</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Google Workspace / wuchang.life">
                    <field name="google_workspace_domain"/>
                    <field name="google_workspace_super_admin"/>
                    <field name="google_workspace_owner_scope"/>
                    <field name="google_workspace_status"/>
                    <field name="google_workspace_note"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
