<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wuchang_franchise_relationship_list" model="ir.ui.view">
        <field name="name">wuchang.franchise.relationship.list</field>
        <field name="model">wuchang.franchise.relationship</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="main_company_id"/>
                <field name="franchisor_partner_id"/>
                <field name="subsidiary_partner_id"/>
                <field name="relationship_type"/>
                <field name="landing_status"/>
                <field name="legal_status"/>
                <field name="revenue_status"/>
                <field name="franchise_fee_policy"/>
                <field name="equipment_policy"/>
                <field name="financial_independence_policy"/>
            </list>
        </field>
    </record>

    <record id="view_wuchang_franchise_relationship_form" model="ir.ui.view">
        <field name="name">wuchang.franchise.relationship.form</field>
        <field name="model">wuchang.franchise.relationship</field>
        <field name="arch" type="xml">
            <form string="公益捐贈型加盟框架">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="main_company_id"/>
                    </group>

                    <group string="關係主體">
                        <field name="franchisor_partner_id"/>
                        <field name="subsidiary_partner_id"/>
                        <field name="relationship_type"/>
                    </group>

                    <group string="狀態">
                        <field name="landing_status"/>
                        <field name="legal_status"/>
                        <field name="revenue_status"/>
                        <field name="equipment_cost_bearer"/>
                    </group>

                    <group string="公益捐贈型加盟條款">
                        <field name="franchise_fee_policy"/>
                        <field name="equipment_policy"/>
                        <field name="financial_independence_policy"/>
                        <field name="franchise_fee_donated_to_association"/>
                        <field name="equipment_provided_by_franchisor"/>
                        <field name="no_revenue_return_obligation"/>
                        <field name="no_royalty_obligation"/>
                    </group>

                    <notebook>
                        <page string="條款摘要">
                            <field name="public_interest_terms_summary"/>
                        </page>
                        <page string="備註">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wuchang_franchise_relationship" model="ir.actions.act_window">
        <field name="name">公益捐贈型加盟框架</field>
        <field name="res_model">wuchang.franchise.relationship</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_wuchang_franchise_relationship"
              name="公益捐贈型加盟框架"
              parent="menu_wuchang_property_root"
              action="action_wuchang_franchise_relationship"
              sequence="90"/>
</odoo>
