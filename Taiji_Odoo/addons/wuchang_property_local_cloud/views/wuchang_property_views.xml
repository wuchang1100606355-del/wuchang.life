    <menuitem id="menu_wuchang_field_device" name="第2件 場域驗證設備" parent="menu_wuchang_property_root" action="action_wuchang_field_device" sequence="30"/>

    <record id="view_wuchang_governance_node_list" model="ir.ui.view">
        <field name="name">wuchang.trusted.governance.node.list</field>
        <field name="model">wuchang.trusted.governance.node</field>
        <field name="arch" type="xml">
            <list>
