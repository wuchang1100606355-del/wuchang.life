        <field name="res_model">wuchang.permission.proof</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_wuchang_permission_proof" name="5維碼/權限證明" parent="menu_wuchang_property_root" action="action_wuchang_permission_proof" sequence="60"/>

    <record id="view_wuchang_happiness_ledger_list" model="ir.ui.view">
        <field name="name">wuchang.happiness.ledger.list</field>
        <field name="model">wuchang.happiness.ledger</field>
        <field name="arch" type="xml">
            <list>
                <field name="member_id"/>
                <field name="group_customer_id"/>
                <field name="ledger_type"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="memo"/>
            </list>
        </field>
    </record>
    <record id="action_wuchang_happiness_ledger" model="ir.actions.act_window">
        <field name="name">幸福幣/管理費折抵帳</field>
        <field name="res_model">wuchang.happiness.ledger</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_wuchang_happiness_ledger" name="幸福幣/折抵帳" parent="menu_wuchang_property_root" action="action_wuchang_happiness_ledger" sequence="70"/>
