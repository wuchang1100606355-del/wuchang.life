    <menuitem id="menu_wuchang_local_cloud" name="第4件 在地雲端商設備" parent="menu_wuchang_property_root" action="action_wuchang_local_cloud" sequence="50"/>

    <record id="view_wuchang_permission_proof_list" model="ir.ui.view">
        <field name="name">wuchang.permission.proof.list</field>
        <field name="model">wuchang.permission.proof</field>
        <field name="arch" type="xml">
            <list>
                <field name="one_time_code_hash"/>
                <field name="member_id"/>
                <field name="group_customer_id"/>
