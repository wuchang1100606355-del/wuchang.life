        <field name="res_model">wuchang.trusted.governance.node</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_wuchang_governance_node" name="第3件 受託治理設備" parent="menu_wuchang_property_root" action="action_wuchang_governance_node" sequence="40"/>

    <record id="view_wuchang_local_cloud_list" model="ir.ui.view">
        <field name="name">wuchang.local.cloud.appliance.list</field>
        <field name="model">wuchang.local.cloud.appliance</field>
        <field name="arch" type="xml">
            <list>
