        <field name="res_model">wuchang.member.sovereign.device</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_wuchang_member_sov_device" name="會員設備" parent="menu_wuchang_property_root" action="action_wuchang_member_sov_device" sequence="25"/>

    <record id="view_wuchang_field_device_list" model="ir.ui.view">
