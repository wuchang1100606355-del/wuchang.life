  "d1_d8_projection": {
    "D1": {
      "name": "INTENT",
      "required": true,
      "contract": "建立同一小J的身分封包、設備登入與Open WebUI候選能力封套；不得啟用或建立第二核心。"
    },
    "D2": {
      "name": "STATE",
      "required": true,
      "contract": "CANDIDATE_NOT_CANONICAL；Open WebUI真實登入、設備綁定、Session及正式能力投影仍未證據閉合。"
    },
    "D3": {
      "name": "COORDINATE",
      "required": true,
      "contract": "taiji01、同一小J身分根、既有9107 Total Field、Open WebUI UI adapter與受治理Executor之精確責任座標。"
    },
    "D4": {
      "name": "EVIDENCE",
      "required": true,
      "contract": "綁定來源設計SHA、W7TP schema身分證據候選SHA、Session/設備/席位/同意/回執ref及明確NOT_EVIDENCED狀態。"
    },
    "D5": {
      "name": "EXECUTION_POLICY",
      "required": true,
      "contract": "本次僅E2單檔候選；任何E3-E5登入綁定、信任寫入、runtime、DB、部署或正式效果都需獨立授權與Total Field裁決。"
    },
    "D6": {
      "name": "GENERATIVE_TRANSMISSION",
      "required": true,
      "contract": "只使用原生8D意圖場封包、ref、lookup、重構條件與驗證；帳號、網路、WebAuthn及UI只是通道，不是生成式傳輸本體。"
    },
    "D7": {
      "name": "RED_TEAM_RISK_CONFINEMENT",
      "required": true,
      "contract": "阻擋帳號升權、未登記設備自動信任、UI繞過、raw臉部/PIN外傳或儲存、舊Session重播、跨會員及第二核心。"
    },
    "D8": {
      "name": "ENVELOPE_AUTHORITY",
      "required": true,
      "contract": "Total Field驗證身分封包、權限邊界與結果並作最終PASS/HOLD/REJECT；Open WebUI、帳號、模型及設備權威皆為NONE。"
    }
  },
