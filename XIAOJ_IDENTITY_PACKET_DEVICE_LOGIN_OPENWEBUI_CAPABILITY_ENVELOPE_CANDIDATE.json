  "product_output_contract": {
    "intended_users": [
      "Founder",
      "organization_operator",
      "member"
    ],
    "user_need": "以同一小J及同一身分根，透過已登記設備或未登記設備的人審流程重構受限Session，並在Open WebUI只投影本次身分封包允許的技能、模型、工具、UI與資料範圍。",
    "product_outcome": "一份不可自行生效的能力封套候選；帳號僅為驗證通道，9107以同一身分封包在伺服器端重新驗證，Open WebUI沒有身分根、Total Field或直接執行權威。",
    "deliverables": [
      "XIAOJ_IDENTITY_PACKET_DEVICE_LOGIN_OPENWEBUI_CAPABILITY_ENVELOPE_CANDIDATE.json"
    ],
    "interface_behavior": "身分封包Session進入Open WebUI後，只顯示候選能力投影；任何列舉、模型呼叫、工具呼叫、資料查詢或執行要求均送往既有9107封套重新驗證，結果以證據與人類滿意度回覆。",
    "quality_thresholds": [
      "PRIMARY_FAMILY_F02_IDENTITY_SEAT_CONSENT",
      "SECONDARY_FAMILIES_F03_INTENT_PRODUCT_OUTPUT_AND_F16_PUBLIC_EXPERIENCE",
      "CURRENT_OPERATION_EFFECT_E2",
      "MAXIMUM_RUNTIME_EFFECT_E5_REQUIRES_SEPARATE_AUTHORIZATION",
      "ONE_XIAOJ_ONE_IDENTITY_ROOT_ONE_TOTAL_FIELD_ONE_ADI_STATE_SPACE",
      "COMPLETE_8D_AND_ADI_COORDINATES_REQUIRED",
      "ACCOUNT_AUTHENTICATION_CHANNEL_ONLY",
      "DEVICE_AUTHORITY_NONE",
      "OPENWEBUI_AUTHORITY_NONE",
      "SERVER_SIDE_IDENTITY_PACKET_RECHECK_REQUIRED",
      "W7TP_SCHEMA_IDENTITY_PENDING_TOTAL_FIELD_DECISION"
    ],
    "acceptance_criteria": [
      "PASS_CANDIDATE_MANIFEST_SCHEMA_VALID",
      "PASS_CANDIDATE_RED_TEAM_PRE_DEFINITION",
      "TRUSTED_DEVICE_AND_UNREGISTERED_DEVICE_FLOWS_DEFINED",
