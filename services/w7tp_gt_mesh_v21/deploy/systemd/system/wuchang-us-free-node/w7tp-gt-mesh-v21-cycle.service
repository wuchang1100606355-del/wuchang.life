[Unit]
Description=W7TP 8D ADI low-cost index and generative-transmission cycle (wuchang-us-free-node)
Wants=network-online.target
After=network-online.target w7tp-gt-mesh-v21.service

[Service]
Type=oneshot
WorkingDirectory=/opt/w7tp/gt_mesh_v21/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/w7tp/gt_mesh_v21/current
UMask=0077
ExecStartPre=/usr/bin/env python3 -m w7tp_gt_mesh --config /etc/w7tp-gt-mesh-v21/config.json doctor
ExecStart=/usr/bin/env python3 -m w7tp_gt_mesh --config /etc/w7tp-gt-mesh-v21/config.json cycle
ExecStart=/usr/bin/env python3 -m w7tp_gt_mesh --config /etc/w7tp-gt-mesh-v21/config.json retry
TimeoutStartSec=240s
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/w7tp-gt-mesh-v21/wuchang-us-free-node
