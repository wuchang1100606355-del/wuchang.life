[Unit]
Description=W7TP 8D ADI generative-transmission mesh receiver (wuchang-us-free-node)
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=simple
WorkingDirectory=/opt/w7tp/gt_mesh_v21/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/w7tp/gt_mesh_v21/current
UMask=0077
ExecStartPre=/usr/bin/env python3 -m w7tp_gt_mesh --config /etc/w7tp-gt-mesh-v21/config.json doctor
ExecStart=/usr/bin/env python3 -m w7tp_gt_mesh --config /etc/w7tp-gt-mesh-v21/config.json serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/w7tp-gt-mesh-v21/wuchang-us-free-node

[Install]
WantedBy=multi-user.target
