[Unit]
Description=W7TP 8D ADI generative-transmission mesh receiver (MSI)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/taiji_admin/.local/opt/w7tp_gt_mesh_v21/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/taiji_admin/.local/opt/w7tp_gt_mesh_v21/current
UMask=0077
ExecStartPre=/usr/bin/env python3 -m w7tp_gt_mesh --config /home/taiji_admin/.config/w7tp-gt-mesh-v21/config.json doctor
ExecStart=/usr/bin/env python3 -m w7tp_gt_mesh --config /home/taiji_admin/.config/w7tp-gt-mesh-v21/config.json serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
