[Unit]
Description=W7TP 8D ADI low-cost index and generative-transmission cycle (MSI)
Wants=network-online.target
After=network-online.target w7tp-gt-mesh-v21.service

[Service]
Type=oneshot
WorkingDirectory=/home/taiji_admin/.local/opt/w7tp_gt_mesh_v21/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/taiji_admin/.local/opt/w7tp_gt_mesh_v21/current
UMask=0077
ExecStartPre=/usr/bin/env python3 -m w7tp_gt_mesh --config /home/taiji_admin/.config/w7tp-gt-mesh-v21/config.json doctor
ExecStart=/usr/bin/env python3 -m w7tp_gt_mesh --config /home/taiji_admin/.config/w7tp-gt-mesh-v21/config.json cycle
ExecStart=/usr/bin/env python3 -m w7tp_gt_mesh --config /home/taiji_admin/.config/w7tp-gt-mesh-v21/config.json retry
TimeoutStartSec=240s
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
