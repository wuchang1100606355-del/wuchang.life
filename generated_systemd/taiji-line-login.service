[Unit]
Description=Taiji LINE Login Bridge 8103
After=taiji-gateway.service
Wants=taiji-gateway.service

[Service]
Type=simple
Environment=TAIJI_ROOT=%h/Taiji_Hub
EnvironmentFile=%h/.secrets/taiji_line_login.env
WorkingDirectory=%h/Taiji_Hub
ExecStart=/usr/bin/python3 %h/Taiji_Hub/services/line_login/simple_line_login_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
