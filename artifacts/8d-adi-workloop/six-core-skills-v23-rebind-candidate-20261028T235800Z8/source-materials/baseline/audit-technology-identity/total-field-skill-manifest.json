  "product_output_contract": {
    "intended_users": ["Founder", "受授權技術分析者", "總場審查者"],
    "user_need": "在效果、carrier、介面或效能相似時，仍能以因果證據辨識真正的技術同一、局部重疊、效果等價或技術差異。",
    "product_outcome": "形成一份唯讀、六軸、離散且可追溯的技術身分候選裁決，不使用加權相似分數，也不推論專利或法律結論。",
    "deliverables": ["六軸技術比較結果", "五種離散技術身分裁決", "EV0-EV5 證據成熟度與來源引用", "結構性消除與一般優化分界", "carrier、重構與驗證語義分界", "唯一缺件或下一證據行動"],
    "interface_behavior": "接受兩項技術及六軸證據，以繁體中文先回傳裁決與決定性軸，再說明證據邊界、未知與唯一下一步。",
    "quality_thresholds": ["六軸完整", "效果等同不取代技術等同", "零加權或浮點身分分數", "EV 證據與 E0-E5 效果分類零混用", "carrier 與重構驗證語義零混淆", "專利與法律推論為零"],
    "acceptance_criteria": ["決定性輸入符合 technology-identity-gate/1.0", "六軸名稱與關係完整", "EV1 以上皆有來源引用", "SAME_MECHANISM 的六軸皆至少 EV3", "同效果但強證據差異回傳 EFFECT_ONLY_EQUIVALENT", "自測全部通過", "未發生資料庫、ADI、canonical 或正式申請寫入"],
    "failure_behavior": "缺少任一軸、證據、來源或技術範圍時回傳 INSUFFICIENT_EVIDENCE 或 PRECONDITION_MISSING；不得以效果類比、模型流暢度或品牌替代證據。",
    "prohibited_outputs": ["加權 IdentityScore、相似度百分比或浮點身分值", "以同效果、同 carrier、同協定或同介面宣稱技術同一", "把優化宣稱成結構性消除", "把一種驗證的消除擴張成完全免驗證", "專利性、新穎性、侵權、有效性、所有權、法律狀態或全球優越性結論", "ALLOW、ACTIVE、canonical 或正式裁決"],
    "allowed_side_effects": []
  },
