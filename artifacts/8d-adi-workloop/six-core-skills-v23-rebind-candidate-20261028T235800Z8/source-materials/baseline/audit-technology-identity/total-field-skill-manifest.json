  "d1_d8_projection": {
    "D1": {"name": "INTENT", "required": true, "contract": "記錄要比較的兩項技術、直接技術身分問題及可見效果關係。"},
    "D2": {"name": "STATE", "required": true, "contract": "記錄每一軸的 SAME、PARTIAL、DIFFERENT、UNKNOWN 與目前候選裁決。"},
    "D3": {"name": "COORDINATE", "required": true, "contract": "綁定技術版本、來源日期、系統位置、比較範圍、因果步驟及適用的8D／ADI引用。"},
    "D4": {"name": "EVIDENCE", "required": true, "contract": "保存六軸 EV0-EV5、來源引用、實作與可重播因果證據，分開事實、重構、推論、衝突與未知。"},
    "D5": {"name": "EXECUTION_POLICY", "required": true, "contract": "只允許唯讀來源解析與離散候選裁決；禁止加權分數、寫回、啟用或正式提交。"},
    "D6": {"name": "GENERATIVE_TRANSMISSION", "required": true, "contract": "本技能不宣稱生成式傳輸；比較時把 carrier 與 W7TP 狀態場重構、協定、驗證及 acceptance 語義分離。"},
    "D7": {"name": "RED_TEAM_RISK_CONFINEMENT", "required": true, "contract": "阻擋效果類比、六軸缺漏、證據級別碰撞、加權身分分數、優化冒充消除、免驗證擴張及專利法律推論。"},
    "D8": {"name": "ENVELOPE_AUTHORITY", "required": true, "contract": "綁定身分 Seat、唯讀範圍、來源證據、候選權威及 Total Field receipt；技能不得自行裁決。"}
