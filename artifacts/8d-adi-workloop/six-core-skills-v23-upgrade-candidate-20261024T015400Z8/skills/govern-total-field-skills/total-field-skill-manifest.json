      "name": "COORDINATE",
      "required": true
    },
    "D4": {
      "contract": "記錄來源、manifest、schema、實作、測試、紅隊、receipt、六軸技術身分與 EV 證據、浮點數值契約與重播結果，以及 SHA-256 證據。",
      "name": "EVIDENCE",
      "required": true
    },
    "D5": {
      "contract": "貫穿式執行 Gate、Guard、Policy、效果分類、append-only 歷史、禁止條件、授權與 rollback。",
      "name": "EXECUTION_POLICY",
      "required": true
    },
    "D6": {
      "contract": "只有技能明確主張 W7TP 時才要求 V2.3 意圖通訊／狀態場封包通訊、自帶協定與驗證的可重構封包；保存 ADI 整數決策索引與時空索引網路，宣告連續運算時另保存非權威浮點資料索引及數值契約；一般 carrier 不算。",
      "name": "GENERATIVE_TRANSMISSION",
      "required": true
    },
    "D7": {
      "contract": "執行定義前、啟用前及操作後紅隊，檢查效果類比冒充技術身分、六軸缺漏、加權分數、carrier 與重構混淆、專利推論、ADI 索引權責、浮點資料升格、H64-TD 與靜默覆寫，保存 finding、修復與 closure evidence。",
      "name": "RED_TEAM_RISK_CONFINEMENT",
      "required": true
    },
    "D8": {
      "contract": "綁定 nonce、TTL、hash、權限、Total Field receiver、裁決 receipt 與最終權威邊界。",
      "name": "ENVELOPE_AUTHORITY",
      "required": true
    }
  },
