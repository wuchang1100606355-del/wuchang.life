      "name": "GENERATIVE_TRANSMISSION",
      "required": true
    },
    "D7": {
      "contract": "執行定義前、啟用前及操作後紅隊，檢查效果類比冒充技術身分、六軸缺漏、加權分數、carrier 與重構混淆、專利推論、ADI 索引權責、浮點資料升格、H64-TD 與靜默覆寫，保存 finding、修復與 closure evidence。",
      "name": "RED_TEAM_RISK_CONFINEMENT",
      "required": true
    },
