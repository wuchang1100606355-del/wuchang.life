#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
cd "$REPO_ROOT"
mkdir -p runtime logs

AUDIT="logs/wuchang_pos_terminal_enable.jsonl"
OUT="runtime/WUCHANG_POS_TERMINAL_ACCESS.txt"

ts() { date -Iseconds; }

audit() {
  local event="$1"
  local detail="${2:-}"
  detail="$(printf '%s' "$detail" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  printf '{"time":"%s","event":"%s","detail":"%s"}\n' "$(ts)" "$event" "$detail" >> "$AUDIT"
}

port_listening() {
  local port="$1"
  ss -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "(:|\])${port}$"
}

echo "======================================================"
echo "     五常 POS 小三機啟用檢查"
echo "======================================================"

audit "pos_terminal_enable_start" "check odoo pos access"

echo "[1] 啟動 Odoo/Postgres 容器"
if command -v docker >/dev/null 2>&1; then
  docker start wuchang_os_pg >/dev/null 2>&1 || true
  docker start wuchang_os_odoo_18 >/dev/null 2>&1 || true
else
  echo "[warn] docker not found"
fi

sleep 2

echo "[2] 檢查 Odoo 8069"
if port_listening 8069; then
  echo "[ok] Odoo 8069 listening"
else
  echo "[fail] Odoo 8069 not listening"
  audit "pos_terminal_enable_fail" "odoo_8069_not_listening"
  exit 1
fi

HTTP_CODE="$(curl -sS -o /tmp/wuchang_odoo_login_check.html -w '%{http_code}' http://127.0.0.1:8069/web/login || true)"
echo "[http] local Odoo /web/login = $HTTP_CODE"

if [ "$HTTP_CODE" != "200" ] && [ "$HTTP_CODE" != "303" ] && [ "$HTTP_CODE" != "302" ]; then
  echo "[warn] Odoo HTTP check unusual: $HTTP_CODE"
fi

echo "[3] 取得 Tailscale Serve 私有 HTTPS 入口"

TAILSCALE_DNS_NAME="$(
  tailscale status --json 2>/dev/null |
    python3 -c 'import json, sys; print((json.load(sys.stdin).get("Self") or {}).get("DNSName", "").rstrip("."))' \
    2>/dev/null || true
)"
TAILSCALE_HTTPS_URL=""
TAILSCALE_HTTP_CODE=""
if [ -n "$TAILSCALE_DNS_NAME" ] &&
   tailscale serve status --json 2>/dev/null | grep -q '"127.0.0.1:8069"'; then
  TAILSCALE_HTTPS_URL="https://${TAILSCALE_DNS_NAME}:8443"
  TAILSCALE_HTTP_CODE="$(
    curl -sS --connect-timeout 5 --max-time 10 -o /tmp/wuchang_odoo_tailscale_check.html \
      -w '%{http_code}' "${TAILSCALE_HTTPS_URL}/web/login" || true
  )"
fi

{
  echo "WUCHANG POS TERMINAL ACCESS"
  echo "TIME=$(ts)"
  echo ""
  echo "PRIMARY_MODE=TAILSCALE_SERVE_PRIVATE_HTTPS"
  if [ -n "$TAILSCALE_HTTPS_URL" ]; then
    echo "POS_URL_TAILSCALE=${TAILSCALE_HTTPS_URL}/web"
    echo "POS_LOGIN_TAILSCALE=${TAILSCALE_HTTPS_URL}/web/login"
    echo "TAILSCALE_LOGIN_HTTP_CODE=${TAILSCALE_HTTP_CODE:-UNKNOWN}"
  else
    echo "POS_URL_TAILSCALE=UNAVAILABLE"
    echo "TAILSCALE_SERVE_REQUIRED=TRUE"
  fi
  echo ""
  echo "LAN_MODE=DISABLED_BY_LOOPBACK_BINDING"
  echo "LAN_NOTE=Odoo 目前只綁定本機，未建立未驗證的 LAN 入口"
  echo ""
  echo "ODOO_LOCAL=http://127.0.0.1:8069/web"
  echo ""
  echo "OPERATION:"
  echo "1. 小三機先登入已授權的 Tailscale 網路"
  echo "2. 使用 POS_URL_TAILSCALE 的私有 HTTPS 入口"
  echo "3. 登入 Odoo 後進入 Point of Sale / 銷售點"
  echo "4. 開啟「聊國咖啡館重新總店 POS」工作階段"
  echo ""
  echo "SECURITY:"
  echo "No Tailscale Funnel"
  echo "No public exposure"
  echo "No firewall change from this script"
} | tee "$OUT"

audit "pos_terminal_access_written" "$OUT"

echo ""
echo "======================================================"
echo "POS_TERMINAL_ENABLE_CHECK_DONE"
echo "access_file=$OUT"
echo "======================================================"
