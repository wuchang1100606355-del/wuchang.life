#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

AUDIENCE="${1:-https://example.com}"
export GOOGLE_APPLICATION_CREDENTIALS="${GOOGLE_APPLICATION_CREDENTIALS:-$PWD/.secrets/taiji-service-account.json}"
PY="$PWD/.venv_sa/bin/python"

"$PY" - <<PY
import json, base64, time
import google.auth.transport.requests
from google.oauth2 import id_token

audience = "$AUDIENCE"
request = google.auth.transport.requests.Request()
token = id_token.fetch_id_token(request, audience)

payload_b64 = token.split(".")[1]
payload_b64 += "=" * (-len(payload_b64) % 4)
payload = json.loads(base64.urlsafe_b64decode(payload_b64.encode()))

print("service_account_token_generated=true")
print("aud=" + str(payload.get("aud")))
print("email=" + str(payload.get("email", payload.get("sub"))))
print("exp=" + time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(payload.get("exp", 0))))
PY
