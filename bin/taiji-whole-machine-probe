#!/usr/bin/env bash
set -uo pipefail

section() {
    printf '\n=== %s ===\n' "$1"
}

section "SYSTEMD STATE"
timeout 5 systemctl is-system-running --wait 2>&1 || true
systemctl --version 2>/dev/null | head -1 || true
ps -p 1 -o pid=,ppid=,user=,stat=,etimes=,comm=,args= || true
printf 'PID1_CHILDREN='
awk '{print NF}' /proc/1/task/1/children 2>/dev/null || printf 'UNAVAILABLE\n'

section "ZOMBIE BY COMMAND"
ps -eo stat=,comm= |
awk '$1~/^Z/{n[$2]++} END{for(k in n) print n[k],k}' |
sort -nr | head -30

section "ZOMBIE BY USER"
ps -eo stat=,user= |
awk '$1~/^Z/{n[$2]++} END{for(k in n) print n[k],k}' |
sort -nr

section "ZOMBIE BY CGROUP/SERVICE"
while read -r pid; do
    awk -F: '$1=="0"{print $3}' "/proc/$pid/cgroup" 2>/dev/null
done < <(ps -eo pid=,stat= | awk '$2~/^Z/{print $1}') |
sort | uniq -c | sort -nr | head -30

section "OLDEST ZOMBIE SAMPLE"
ps -eo pid,ppid,user,stat,etimes,comm,args --sort=-etimes |
awk 'NR==1 || $4~/^Z/' | head -31

section "PID CAPACITY"
printf 'PID_MAX='
cat /proc/sys/kernel/pid_max 2>/dev/null || printf 'UNAVAILABLE\n'
printf 'PROCESS_COUNT='
ps -e --no-headers | wc -l
printf 'THREAD_COUNT='
ps -eLf --no-headers | wc -l

section "FAILED UNITS"
timeout 8 systemctl --failed --no-pager --plain 2>&1 || true

section "PROBE RESULT"
printf 'STATE=PASS_READONLY_PROBE_COMPLETED\n'
printf 'SECRET_READ=FALSE\n'
printf 'NETWORK_CALL=FALSE\n'
printf 'FILES_WRITTEN=FALSE\n'
printf 'SERVICE_STATE_CHANGED=FALSE\n'
