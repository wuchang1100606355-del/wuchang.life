{
  "schema_id": "W7TP_LOCAL_MODEL_TOOL_CONTRACTS_V1",
  "version": "1.0.0",
  "mcp_exposed_tools": [
    {
      "name": "get_total_field_dynamic_context",
      "transport": "stdio",
      "side_effect_class": "NONE",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "minLength": 1, "maxLength": 20000},
          "max_items": {"type": "integer", "minimum": 1, "maximum": 20, "default": 8},
          "identity_class": {"type": "string", "enum": ["founder", "general_member", "unknown"], "default": "unknown"}
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["state", "authority", "policy", "packet_sha256"],
        "properties": {
          "state": {"type": "string"},
          "authority": {"const": "READ_ONLY_CONTEXT_EVIDENCE_NO_DECISION_AUTHORITY"},
          "capability_route": {"type": ["object", "null"]},
          "context_items": {"type": "array"},
          "policy": {"type": "object"},
          "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    {
      "name": "orchestrate_model_source_context",
      "transport": "stdio",
      "side_effect_class": "NONE",
      "input_schema": {
        "type": "object",
        "properties": {
          "mode": {"type": "string", "enum": ["PREPARE_SOURCE_REQUEST", "ASSIMILATE_SOURCE_EXPORTS"]},
          "task_scope": {"type": "string", "minLength": 1, "maxLength": 4000},
          "current_founder_intent_ref": {"type": "string", "minLength": 1, "maxLength": 512},
          "source_account_coordinate": {"type": "string", "maxLength": 240, "default": "UNKNOWN"},
          "source_exports": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object"}}
        },
        "required": ["mode", "task_scope", "current_founder_intent_ref"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["schema_id", "state", "mode", "D8_ENVELOPE_AUTHORITY", "packet_sha256"],
        "properties": {
          "schema_id": {"const": "W7TP_8DADI_MODEL_SOURCE_ORCHESTRATION_V1"},
          "state": {"type": "string"},
          "mode": {"type": "string"},
          "D8_ENVELOPE_AUTHORITY": {"type": "object"},
          "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    }
  ],
  "governance_internal_contracts": [
    {
      "name": "receive_candidate",
      "model_callable": false,
      "purpose": "由既有總場閘道接收 Candidate；不是 Continue 可直接執行工具",
      "required_input": ["source", "skill_id", "dynamic_context_binding", "candidate", "policy"],
      "allowed_result_states": ["CANDIDATE_RECEIVED", "HOLD", "BLOCK", "QUARANTINE"],
      "side_effect_requires_separate_total_field_authorization": true
    },
    {
      "name": "scheduled_health_observation",
      "model_callable": false,
      "purpose": "每天 07:00 與 19:00 由背景排程執行確定性 8DADI 健康觀測；只有漂移才把最小去敏封包交給 xiaoj:latest 分析。",
      "tool_binding": "tools.xiaoj_total_field_health_check:build_health_observation",
      "side_effect_class": "OBSERVATION_ONLY",
      "model_effect_authority": false,
      "repair_requires_current_d8_resolution": true,
      "reobservation_contract": "對齊資料庫、能力包雜湊、既有服務與 8080/8081/8787/9108 端口座標。"
    },
    {
      "name": "shared_drive_metadata_broker",
      "model_callable": false,
      "purpose": "由太極一號既有 rclone 授權集中讀取三個登記共用區的去敏中繼資料，供已登記節點經總場取用。",
      "tool_binding": "services.gateway.shared_resources:shared_drive_list",
      "side_effect_class": "READ_ONLY_EXTERNAL_RESOURCE_METADATA",
      "credentials_remain_on_taiji01": true,
      "cloud_result_is_authority": false,
      "metadata_lookup_is_d6": false,
      "write_or_content_materialization_requires_separate_contract": true,
      "reobservation_contract": "從太極一號列出三個精確 drive_id，並由至少一個區網節點經既有 9002 閘道取得去敏清單。"
    },
    {
      "name": "dual_observation_views",
      "model_callable": false,
      "purpose": "提供總場內部狀態與人類瀏覽器可見效果兩個觀測面。",
      "tool_binding": "services.gateway.shared_resources:internal_state_view+external_state_view",
      "side_effect_class": "NONE",
      "internal_pass_alone_is_completion": false,
      "success_requires_both_views": true
    },
    {
      "name": "model_source_context_persistence",
      "model_callable": false,
      "purpose": "把已取得的模型／帳號來源匯出轉成去敏、來源保留、不可覆寫的本機 D4 封套，並附加到既有 8DADI 動態上下文索引。",
      "tool_binding": "tools.developer_memory_builder:persist_model_source_context",
      "side_effect_class": "LOCAL_APPEND_ONLY_D4_EVIDENCE",
      "raw_export_copied": false,
      "manual_copy_paste_required": false,
      "new_parallel_memory_database": false,
      "may_change_founder_intent_canonical_or_d8": false,
      "reobservation_contract": "重讀本機 source envelope、record 與 memory_index 綁定，確認摘要一致且動態上下文可依意圖命中。"
    }
  ],
  "forbidden_tool_behavior": [
    "explain_as_if_executed",
    "unlisted_tool_call",
    "direct_db_write",
    "direct_deploy_or_restart",
    "direct_router_or_canonical_write",
    "secret_member_plaintext_or_raw_audio_input_or_output"
  ]
}
